---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Lightbox from '../components/Lightbox.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import { languages, localize, useTranslations, type Lang } from '../i18n/utils';
import { unsplash } from '../lib/img';

interface Props {
  lang: Lang;
  /** Ключ страницы для page.title.* / page.desc.* и подсветки меню. */
  page: string;
  /** Путь без языкового префикса, напр. '/tours/classic/'. */
  path: string;
  /** Раздел меню, если отличается от page (напр. tour-classic → tours). */
  section?: string;
  title?: string;
  description?: string;
  image?: string;
}

const { lang, page, path, section, title, description, image } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t(`page.title.${page}`);
const fullTitle = page === 'home' ? `I AM NOMAD — ${pageTitle}` : `${pageTitle} — I AM NOMAD`;
const desc = description ?? t(`page.desc.${page}`);
const ogImage = image ?? unsplash('1689788648053-cd482d1acd9c', 1200, 630);
const site = Astro.site;
const abs = (p: string) => (site ? new URL(p, site).href : p);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var s = localStorage.getItem('theme');
          if (s === 'dark' || (!s && matchMedia('(prefers-color-scheme: dark)').matches)) d.dataset.theme = 'dark';
        } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={abs(localize(path, lang))} />
    {
      (Object.keys(languages) as Lang[]).map((code) => (
        <link rel="alternate" hreflang={code} href={abs(localize(path, code))} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={abs(localize(path, 'ru'))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="I AM NOMAD" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f5f5f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('ui.skip')}</a>
    <Header lang={lang} active={section ?? page} path={path} />
    <ScrollProgress />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFab lang={lang} />
    <Lightbox lang={lang} />

    <script>
      // Плавное появление блоков с [data-reveal].
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      items.forEach((el) => el.dataset.delay && el.style.setProperty('--delay', `${el.dataset.delay}ms`));
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
