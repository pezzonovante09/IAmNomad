---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Lightbox from '../components/Lightbox.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Analytics from '@vercel/analytics/astro';
import { homeHero } from '../data/content';
import { languages, localize, useTranslations, type Lang } from '../i18n/utils';
import { unsplash } from '../lib/img';

interface Props {
  lang: Lang;
  /** Ключ страницы для page.title.* / page.desc.* и подсветки меню. */
  page: string;
  /** Путь без языкового префикса, напр. '/tours/classic/'. */
  path: string;
  /** Раздел меню, если отличается от page (напр. tour-classic → tours). */
  section?: string;
  title?: string;
  description?: string;
  image?: string;
  /** Полный <title> без суффикса « — I AM NOMAD». */
  fullTitle?: string;
  /** Не индексировать (например, 404). */
  noindex?: boolean;
  /** Готовый текст для кнопки WhatsApp на этой странице. */
  whatsappText?: string;
}

const { lang, page, path, section, title, description, image, fullTitle: fullTitleProp, noindex = false, whatsappText } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t(`page.title.${page}`);
const fullTitle = fullTitleProp ?? (page === 'home' ? `I AM NOMAD — ${pageTitle}` : `${pageTitle} — I AM NOMAD`);
const desc = description ?? t(`page.desc.${page}`);
const ogImage = image ?? unsplash(homeHero.id, 1200, 630);
const site = Astro.site;
const abs = (p: string) => (site ? new URL(p, site).href : p);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var s = localStorage.getItem('theme');
          if (s === 'dark' || (!s && matchMedia('(prefers-color-scheme: dark)').matches)) d.dataset.theme = 'dark';
        } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {/* Подтверждение сайта в Google Search Console (аккаунт iamnomadkgz@gmail.com). Не удалять: Google перепроверяет. */}
    <meta name="google-site-verification" content="4Pji7w-sDP1tHBUd2CtEPg2tXpfCRkI_xr6TSdd_QbI" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={abs(localize(path, lang))} />
          {(Object.keys(languages) as Lang[]).map((code) => (
            <link rel="alternate" hreflang={code} href={abs(localize(path, code))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={abs(localize(path, 'en'))} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="I AM NOMAD" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    {!noindex && <meta property="og:url" content={abs(localize(path, lang))} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f5f5f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('ui.skip')}</a>
    <Header lang={lang} active={section ?? page} path={path} />
    <ScrollProgress />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFab lang={lang} text={whatsappText} />
    <Analytics />
    <Lightbox lang={lang} />

    <script>
      import { track } from '@vercel/analytics';

      // Откуда пришёл посетитель: метки рекламы, домен источника и первая страница.
      // Живёт, пока открыта вкладка, и уходит вместе с заявкой (см. LeadForm).
      try {
        if (!sessionStorage.getItem('landing')) {
          const params = new URLSearchParams(location.search);
          const info: Record<string, string> = { landing: location.pathname };
          for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term']) {
            const value = params.get(key);
            if (value) info[key] = value.slice(0, 200);
          }
          if (document.referrer) {
            const host = new URL(document.referrer).hostname;
            if (host !== location.hostname) info.referrer = host;
          }
          sessionStorage.setItem('landing', JSON.stringify(info));
        }
      } catch {}

      // Счётчик нажатий на способы связи (Vercel Analytics).
      document.addEventListener('click', (e) => {
        const href = (e.target as Element).closest?.('a[href]')?.getAttribute('href') ?? '';
        const type = href.includes('wa.me') ? 'whatsapp' : href.startsWith('tel:') ? 'phone' : href.startsWith('mailto:') ? 'email' : '';
        if (type) track('contact_click', { type, path: location.pathname });
      });

      // Крупные заголовки никогда не рвут слова: если самое длинное слово не влезает
      // в ширину блока, шрифт уменьшается ровно настолько, чтобы влезло.
      const FIT = [
        'h1', 'h2', '.h1', '.h2', '[data-fit]',
        '.hero__title', '.hero__name', '.hero__region-name', '.ti__title', '.ti__price',
        '.what__title', '.why__title', '.book__title', '.cta-bar__text', '.st__focus', '.st__total',
        '.mn__title', '.blk__title', '.story__title', '.intro__title', '.svc__title', '.steps__title',
        '.day__label', '.day__time', '.stats__value', '.th__fact dd', '.dates__value', '.rev__text',
        '.faq__text', '.pg__title', '.tc__title', '.show-teaser__stat', '.what__num',
      ].join(',');
      // Содержимое блоков с горизонтальной прокруткой может уходить за край экрана: это не переполнение.
      const SCROLLERS = '.day';

      // Какую долю ширины текста вмещает блок: 1 — всё влезло, меньше 1 — шрифт надо уменьшить.
      function room(el: HTMLElement, vw: number) {
        const width = el.scrollWidth;
        const screen = el.closest(SCROLLERS) ? Infinity : vw + 0.5 - el.getBoundingClientRect().left;
        return width > Math.min(el.clientWidth + 1, screen) ? Math.min(el.clientWidth, screen) / width : 1;
      }

      function fitAll(root: ParentNode = document) {
        const vw = document.documentElement.clientWidth;
        const els = Array.from(root.querySelectorAll<HTMLElement>(FIT));
        els.forEach((el) => (el.style.fontSize = ''));
        let jobs = els
          .filter((el) => el.clientWidth)
          .map((el) => {
            const size = parseFloat(getComputedStyle(el).fontSize);
            return { el, size, min: size * 0.45 };
          });
        // Ширина текста пропорциональна шрифту, поэтому хватает одного-двух уточнений. Сначала все замеры,
        // потом все правки: браузер пересчитывает раскладку один раз за проход, а не на каждом шаге.
        for (let pass = 0; pass < 3 && jobs.length; pass++) {
          const rooms = jobs.map((job) => room(job.el, vw));
          jobs = jobs.filter((job, i) => {
            if (rooms[i] >= 1) return false;
            job.size = Math.max(job.size * rooms[i] * 0.995, job.min);
            job.el.style.fontSize = `${job.size}px`;
            return job.size > job.min;
          });
        }
      }
      (window as any).__fit = fitAll;

      fitAll();
      document.fonts?.ready.then(() => fitAll());
      let t: number | undefined;
      let lastWidth = innerWidth;
      addEventListener('resize', () => {
        // На телефоне высота окна меняется при прокрутке (адресная строка): заголовкам это безразлично.
        if (innerWidth === lastWidth) return;
        lastWidth = innerWidth;
        clearTimeout(t);
        t = window.setTimeout(() => fitAll(), 120);
      });

      // Плавное появление блоков с [data-reveal].
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      items.forEach((el) => el.dataset.delay && el.style.setProperty('--delay', `${el.dataset.delay}ms`));
      if ('IntersectionObserver' in window) {
        // У «занавеса» clip-path полностью скрывает сам элемент, и IntersectionObserver
        // считает его невидимым (ratio = 0) — поэтому следим за родителем.
        const watched = new Map<Element, HTMLElement[]>();
        items.forEach((el) => {
          const target = el.dataset.reveal === 'curtain' && el.parentElement ? el.parentElement : el;
          watched.set(target, [...(watched.get(target) ?? []), el]);
        });
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                watched.get(entry.target)?.forEach((el) => el.classList.add('is-visible'));
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        watched.forEach((_, target) => io.observe(target));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
