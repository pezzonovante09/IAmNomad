---
// Зелёный блок-призыв с вращающимся тюндюком.
import Icon from './Icon.astro';
import Ornament from './Ornament.astro';

interface Link {
  href: string;
  label: string;
  external?: boolean;
  icon?: 'whatsapp';
}

interface Props {
  kicker?: string;
  title: string;
  text?: string;
  primary: Link;
  secondary?: Link;
}

const { kicker, title, text, primary, secondary } = Astro.props;
const ext = (l: Link) => (l.external ? { target: '_blank', rel: 'noopener' } : {});
---

<section class="cta">
  <div class="cta__text">
    {kicker && <p class="label" data-reveal="fade">{kicker}</p>}
    <h2 class="h2" data-reveal>{title}</h2>
    {text && <p class="cta__lead" data-reveal>{text}</p>}
    <div class="cta__actions" data-reveal>
      <a href={primary.href} class="btn btn--light" {...ext(primary)}>
        {primary.label}
        <span aria-hidden="true">→</span>
      </a>
      {
        secondary && (
          <a href={secondary.href} class="btn btn--glass" {...ext(secondary)}>
            {secondary.label}
            {secondary.icon && <Icon name={secondary.icon} />}
          </a>
        )
      }
    </div>
  </div>
  <div class="cta__disc" aria-hidden="true">
    <Ornament variant="tunduk" stroke="#C5A059" />
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 8vw, 120px) var(--gutter);
    border-top: 1px solid var(--line);
    background: #0d3e26;
    color: #f5f5f3;
  }

  .cta__text {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 20px;
    max-width: 900px;
  }

  .cta__lead {
    max-width: 58ch;
    color: rgb(245 245 243 / 0.85);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .cta__disc {
    position: absolute;
    right: clamp(-160px, -8vw, -40px);
    top: 50%;
    width: clamp(280px, 38vw, 560px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0.55;
  }

  .cta__disc :global(svg) {
    width: 100%;
    height: 100%;
    animation: spin 60s linear infinite;
  }
</style>
