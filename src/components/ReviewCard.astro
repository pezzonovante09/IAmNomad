---
// Карточка отзыва. Рендерится и на сервере, и (через <template>) в браузере из данных Supabase:
// атрибуты data-rc-* — точки, куда скрипт на странице «Отзывы» подставляет значения.
import Icon from './Icon.astro';

interface Props {
  name?: string;
  text?: string;
  /** Ссылка на фото аккаунта Google. */
  avatar?: string;
  rating?: number;
  index?: number;
}

const { name = '', text = '', avatar = '', rating = 5, index = 0 } = Astro.props;
---

<figure class="rc" data-reveal style={`--i:${index % 3}`}>
  <div class="rc__top">
    <span class="rc__stars" aria-label={`${rating}/5`} data-rc-stars>
      {[1, 2, 3, 4, 5].map((n) => <span class:list={['rc__star', { 'is-off': n > rating }]}><Icon name="star" size={14} /></span>)}
    </span>
    <time class="label num" data-rc-date></time>
  </div>
  <blockquote class="rc__text" data-rc-text>{text}</blockquote>
  <figcaption class="rc__author">
    {avatar ? <img src={avatar} alt="" width="40" height="40" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-rc-avatar /> : <span class="rc__initial" aria-hidden="true" data-rc-initial>{name.slice(0, 1)}</span>}
    <span class="label" data-rc-name>{name}</span>
  </figcaption>
</figure>

<style>
  .rc {
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 100%;
    margin: 0;
    padding: 28px var(--gutter);
    background: var(--bg);
  }

  .rc__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rc__stars {
    display: flex;
    gap: 2px;
    color: var(--gold);
  }

  .rc__star.is-off {
    opacity: 0.25;
  }

  :global(.rc__initial) {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    text-transform: uppercase;
  }

  .rc__text {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .rc__author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--line-soft);
  }

  .rc__author img {
    width: 40px;
    height: 40px;
    object-fit: cover;
    filter: grayscale(1);
  }
</style>
