---
import Icon from './Icon.astro';
import { contacts } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  layout?: 'grid' | 'list';
}

const { lang, layout = 'grid' } = Astro.props;
const t = useTranslations(lang);

const items = [
  { icon: 'whatsapp', label: t('footer.whatsapp'), value: contacts.phone, href: contacts.whatsapp, tone: 'wa' },
  { icon: 'telegram', label: t('footer.telegram'), value: contacts.telegramHandle, href: contacts.telegram, tone: 'tg' },
  { icon: 'mail', label: t('footer.email'), value: contacts.email, href: `mailto:${contacts.email}`, tone: 'mail' },
  { icon: 'phone', label: t('footer.phone'), value: contacts.phone, href: contacts.phoneHref, tone: 'phone' },
] as const;
---

<ul class:list={['cc', `cc--${layout}`]}>
  {
    items.map((item, i) => (
      <li data-reveal style={`--i:${i}`}>
        <a
          class="cc__item"
          href={item.href}
          data-tone={item.tone}
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noopener' : undefined}
        >
          <span class="cc__icon">
            <Icon name={item.icon} />
          </span>
          <span class="cc__text">
            <span class="cc__label">{item.label}</span>
            <span class="cc__value">{item.value}</span>
          </span>
          <Icon name="arrow-right" size={18} class="cc__arrow" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .cc {
    display: grid;
    gap: 12px;
    list-style: none;
  }

  .cc--grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 16px;
  }

  .cc__item {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .cc__item:hover {
    border-color: var(--ink-mute);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .cc__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: var(--bg-alt);
  }

  [data-tone='wa'] .cc__icon {
    background: #25d366;
    color: #06351a;
  }

  [data-tone='tg'] .cc__icon {
    background: #2aabee;
    color: #fff;
  }

  [data-tone='mail'] .cc__icon {
    background: var(--gold-soft);
    color: var(--ink);
  }

  [data-tone='phone'] .cc__icon {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .cc__text {
    display: grid;
    min-width: 0;
  }

  .cc__label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-mute);
  }

  .cc__value {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .cc__item :global(.cc__arrow) {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--ink-mute);
    transition: transform 0.3s var(--ease);
  }

  .cc__item:hover :global(.cc__arrow) {
    transform: translateX(3px);
    color: var(--accent);
  }
</style>
