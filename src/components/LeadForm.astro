---
// Форма заявки: письмо на почту компании через Web3Forms и строка в таблице leads (Supabase).
// Без JavaScript форма уходит обычным POST прямо в Web3Forms, поэтому заявка всё равно доходит письмом.
import Icon from './Icon.astro';
import { contacts, supabase, web3forms, whatsappLink } from '../data/site';
import { tours } from '../data/tours';
import { localize, useTranslations, type Lang } from '../i18n/utils';
import { routes } from '../lib/routes';

interface Props {
  lang: Lang;
  variant?: 'lead' | 'contact' | 'corporate' | 'show';
  id?: string;
  /** Своё сообщение после успешной отправки. */
  success?: string;
  /** Своя подпись кнопки. */
  submitLabel?: string;
}

const { lang, variant = 'lead', id = 'form', success, submitLabel } = Astro.props;
const t = useTranslations(lang);

const subjects = {
  lead: 'Заявка на тур — I AM NOMAD',
  contact: 'Сообщение с сайта — I AM NOMAD',
  corporate: 'Корпоративная заявка — I AM NOMAD',
  show: 'Заявка на шоу — I AM NOMAD SHOW',
};
const eventTypes = ['group', 'vip', 'corporate', 'private', 'other'];
const corpTypes = ['meeting', 'incentive', 'teambuilding', 'cultural', 'other'];
const f = (name: string) => `${id}-${name}`;
// «Отправляя заявку, вы соглашаетесь с {policy}…» — {policy} становится ссылкой на политику.
const [consentBefore, consentAfter = ''] = t('legal.form.consent').split('{policy}');
const optional = t('form.optional');
const waHref = whatsappLink(t('whatsapp.text'));
// Шаблоны проверки. Символы в [] экранированы: браузеры разбирают pattern в строгом режиме (флаг v).
const NOT_BLANK = '.*\\S.*';
const PHONE = '[0-9+\\(\\)\\s.\\-]{5,}';
const EMAIL = '[^@\\s]+@[^@\\s]+\\.[^@\\s]+';
---

<form
  class="form"
  method="post"
  action={web3forms.endpoint}
  data-form
  data-endpoint={web3forms.endpoint}
  data-db={`${supabase.url}/rest/v1/leads`}
  data-db-key={supabase.key}
  data-variant={variant}
  data-lang={lang}
  data-success={success ?? t('misc.formSuccess')}
  data-error={t('misc.formError')}
  data-sending={t('form.sending')}
  data-builder-prefix={t('builder.requestPrefix')}
  data-custom-title={t('tour.custom.title')}
  data-contact-error={t('form.contactError')}
  data-tour-heading={t('form.tourHeading')}
>
  <input type="hidden" name="access_key" value={web3forms.accessKey} />
  <input type="hidden" name="subject" value={subjects[variant]} />
  <input type="hidden" name="from_name" value="Заявка с сайта I AM NOMAD" />
  <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

  {
    variant === 'show' ? (
      <>
        <div class="form__row">
          <div class="field">
            <label class="field__label" for={f('name')}>{t('form.name')}</label>
            <input class="field__input" type="text" id={f('name')} name="name" autocomplete="name" maxlength="200" pattern={NOT_BLANK} title={t('form.fieldError')} required />
          </div>
          <div class="field">
            <label class="field__label" for={f('email')}>{t('form.email')}</label>
            <input class="field__input" type="email" id={f('email')} name="email" autocomplete="email" maxlength="200" pattern={EMAIL} required />
          </div>
        </div>
        <div class="form__row">
          <div class="field">
            <label class="field__label" for={f('phone')}>{t('form.phone')}</label>
            <input class="field__input" type="tel" id={f('phone')} name="phone" autocomplete="tel" maxlength="100" pattern={PHONE} title={t('form.phoneError')} />
          </div>
          <div class="field">
            <label class="field__label" for={f('whatsapp')}>{t('show.form.whatsapp')}</label>
            <input class="field__input" type="tel" id={f('whatsapp')} name="whatsapp" autocomplete="tel" maxlength="100" pattern={PHONE} title={t('form.phoneError')} />
          </div>
        </div>
        <p class="form__hint">{t('form.contactHint')}</p>
        <div class="form__row">
          <div class="field">
            <label class="field__label" for={f('date')}>{t('show.form.date')} <span class="field__opt">({optional})</span></label>
            <input class="field__input" type="date" id={f('date')} name="date" />
          </div>
          <div class="field">
            <label class="field__label" for={f('guests')}>{t('show.form.guests')} <span class="field__opt">({optional})</span></label>
            <input class="field__input" type="number" min="1" inputmode="numeric" id={f('guests')} name="guests" />
          </div>
        </div>
        <div class="field">
          <label class="field__label" for={f('type')}>{t('show.form.type')}</label>
          <select class="field__input" id={f('type')} name="event_type">
            {eventTypes.map((k) => <option value={t(`show.form.type.${k}`)}>{t(`show.form.type.${k}`)}</option>)}
          </select>
        </div>
      </>
    ) : variant === 'corporate' ? (
      <>
        <div class="field">
          <label class="field__label" for={f('company')}>{t('form.company')}</label>
          <input class="field__input" type="text" id={f('company')} name="company" autocomplete="organization" maxlength="200" pattern={NOT_BLANK} title={t('form.fieldError')} required />
        </div>
        <div class="form__row">
          <div class="field">
            <label class="field__label" for={f('contact')}>{t('form.contact')}</label>
            <input class="field__input" type="text" id={f('contact')} name="contact" autocomplete="name" maxlength="200" pattern={NOT_BLANK} title={t('form.fieldError')} required />
          </div>
          <div class="field">
            <label class="field__label" for={f('email')}>{t('form.workEmail')}</label>
            <input class="field__input" type="email" id={f('email')} name="email" autocomplete="email" maxlength="200" pattern={EMAIL} required />
          </div>
        </div>
        <div class="form__row">
          <div class="field">
            <label class="field__label" for={f('country')}>{t('form.country')}</label>
            <input class="field__input" type="text" id={f('country')} name="country" autocomplete="country-name" maxlength="200" pattern={NOT_BLANK} title={t('form.fieldError')} required />
          </div>
          <div class="field">
            <label class="field__label" for={f('type')}>{t('form.eventType')}</label>
            <select class="field__input" id={f('type')} name="event_type" required>
              {corpTypes.map((k) => <option value={t(`form.corp.type.${k}`)}>{t(`form.corp.type.${k}`)}</option>)}
            </select>
          </div>
        </div>
        <div class="form__row">
          <div class="field">
            <label class="field__label" for={f('participants')}>{t('form.participants')} <span class="field__opt">({optional})</span></label>
            <input class="field__input" type="number" min="1" inputmode="numeric" id={f('participants')} name="participants" />
          </div>
          <div class="field">
            <label class="field__label" for={f('dates')}>{t('form.dates')} <span class="field__opt">({optional})</span></label>
            <input class="field__input" type="text" id={f('dates')} name="dates" maxlength="200" />
          </div>
        </div>
        <div class="field">
          <label class="field__label" for={f('budget')}>{t('form.budget')}</label>
          <input class="field__input" type="text" id={f('budget')} name="budget" maxlength="200" />
        </div>
      </>
    ) : (
      <>
        <div class="field">
          <label class="field__label" for={f('name')}>{t('form.name')}</label>
          <input class="field__input" type="text" id={f('name')} name="name" autocomplete="name" maxlength="200" pattern={NOT_BLANK} title={t('form.fieldError')} required />
        </div>
        <div class="form__row">
          <div class="field">
            <label class="field__label" for={f('phone')}>{t('form.phoneOrWhatsapp')}</label>
            <input class="field__input" type="tel" id={f('phone')} name="phone" autocomplete="tel" maxlength="100" pattern={PHONE} title={t('form.phoneError')} />
          </div>
          <div class="field">
            <label class="field__label" for={f('email')}>{t('form.email')}</label>
            <input class="field__input" type="email" id={f('email')} name="email" autocomplete="email" maxlength="200" pattern={EMAIL} required />
          </div>
        </div>
        <p class="form__hint">{t('form.contactHint')}</p>
        <div class="field">
          <label class="field__label" for={f('tour')}>{t('form.tour')} <span class="field__opt">({optional})</span></label>
          <input class="field__input" type="text" id={f('tour')} name="tour" maxlength="300" list={f('tours')} data-field-tour />
          <datalist id={f('tours')}>
            {tours.map((tour) => (
              <option value={t(`${tour.card}.title`)} data-slug={tour.slug} />
            ))}
          </datalist>
        </div>
      </>
    )
  }

  <div class="field">
    <label class="field__label" for={f('message')}>{variant === 'show' ? t('show.form.comment') : variant === 'corporate' ? t('form.eventDetails') : t('form.message')} <span class="field__opt">({optional})</span></label>
    <textarea class="field__input" id={f('message')} name="message" rows="5" maxlength="5000" data-field-message></textarea>
  </div>

  <p class="form__consent">
    {consentBefore}<a href={localize(routes.privacy, lang)} target="_blank" rel="noopener">{t('legal.form.policyIn')}</a>{consentAfter}
  </p>
  <button type="submit" class="btn btn--accent form__submit">
    <span data-label>{submitLabel ?? (variant === 'corporate' ? t('btn.requestQuote') : t('btn.send'))}</span>
    <Icon name="arrow-right" />
  </button>
  <p class="form__status" role="status" aria-live="polite" data-status></p>
  <p class="form__fallback" data-fallback hidden>
    <a href={waHref} target="_blank" rel="noopener">{t('ui.whatsappChat')}</a>
    <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
  </p>

  <!-- После успешной отправки форма прячется, а на её месте появляется этот блок. -->
  <div class="form__done" data-done hidden tabindex="-1">
    <span class="form__done-icon"><Icon name="check" /></span>
    <p class="form__done-title">{t('misc.formSuccessTitle')}</p>
    <p class="form__done-text" role="status" aria-live="polite" data-done-text></p>
    <a href={waHref} class="form__done-link" target="_blank" rel="noopener">{t('form.doneWhatsapp')}</a>
    <button type="button" class="btn btn--outline form__again" data-again>
      <span>{t('misc.formAgain')}</span>
      <Icon name="arrow-right" />
    </button>
  </div>
</form>

<style>
  .form {
    display: grid;
    gap: 18px;
  }

  .form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 18px;
  }

  .form__hint {
    margin-top: -8px;
    font-size: 14px;
    color: var(--ink-mute);
  }

  .form__submit {
    justify-self: start;
    min-width: 200px;
  }

  .form__consent {
    max-width: 640px;
    font-size: 14px;
    color: var(--ink-mute);
    line-height: 1.55;
  }

  .form__consent a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .form__status {
    min-height: 1.5em;
    font-weight: 600;
  }

  .form__status[data-type='success'] {
    color: var(--success);
  }

  .form__status[data-type='error'] {
    color: var(--danger);
  }

  .form__fallback {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: -8px;
    font-weight: 600;
  }

  .form__fallback[hidden] {
    display: none;
  }

  .form__fallback a,
  .form__done-link {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  /* Заявка отправлена: поля скрыты, виден только блок с благодарностью. */
  .form.is-done > :not([data-done]) {
    display: none;
  }

  .form__done {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--success);
    background: var(--accent-soft);
    outline: none;
  }

  .form__done[hidden] {
    display: none;
  }

  .form__done-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--success);
    color: var(--on-accent);
  }

  .form__done-icon :global(svg) {
    width: 26px;
    height: 26px;
  }

  .form__done-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .form__done-text {
    max-width: 520px;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .form__again {
    margin-top: 8px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .form__done:not([hidden]) {
      animation: form-done-in 0.5s var(--ease) both;
    }
  }

  @keyframes form-done-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (max-width: 520px) {
    .form__submit,
    .form__again {
      justify-self: stretch;
    }

    .form__again {
      white-space: normal;
    }
  }
</style>

<script>
  import { track } from '@vercel/analytics';

  // Один запрос не держит форму дольше этого времени.
  const TIMEOUT_MS = 15000;

  function timedFetch(url: string, init: RequestInit) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), TIMEOUT_MS);
    // keepalive: запрос дойдёт, даже если посетитель закроет страницу сразу после подтверждения.
    return fetch(url, { ...init, keepalive: true, signal: ctrl.signal }).finally(() => clearTimeout(timer));
  }

  // true, как только сработала хотя бы одна задача; false, когда не сработала ни одна.
  function firstOk(tasks: Promise<boolean>[]) {
    return new Promise<boolean>((resolve) => {
      let left = tasks.length;
      tasks.forEach((task) =>
        task
          .catch(() => false)
          .then((ok) => {
            if (ok) resolve(true);
            else if (--left === 0) resolve(false);
          }),
      );
    });
  }

  // Откуда пришёл посетитель (см. BaseLayout): метки рекламы, домен источника, страница входа.
  function landingInfo(): Record<string, string> {
    try {
      return JSON.parse(sessionStorage.getItem('landing') ?? '{}');
    } catch {
      return {};
    }
  }

  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]');
    const fallback = form.querySelector<HTMLElement>('[data-fallback]');
    const button = form.querySelector<HTMLButtonElement>('[type="submit"]');
    const label = button?.querySelector<HTMLElement>('[data-label]');
    const tourField = form.querySelector<HTMLInputElement>('[data-field-tour]');
    const messageField = form.querySelector<HTMLTextAreaElement>('[data-field-message]');
    const emailField = form.querySelector<HTMLInputElement>('input[name="email"]');
    const phoneFields = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="phone"], input[name="whatsapp"]'));

    // Подстановка тура из ссылки ?tour=slug (кнопки заявки на страницах туров).
    const slug = new URLSearchParams(location.search).get('tour');
    if (slug && tourField) {
      const option = form.querySelector<HTMLOptionElement>(`datalist option[data-slug="${CSS.escape(slug)}"]`);
      if (option) {
        tourField.value = option.value;
        const heading = form.closest('#contact-form')?.querySelector('h2');
        if (heading) heading.textContent = `${form.dataset.tourHeading}: ${option.value}`;
      }
    }

    // Подстановка маршрута из конструктора индивидуального тура.
    // Если браузер запрещает хранилище, ошибка не должна останавливать форму: дальше подключается отправка.
    try {
      const raw = sessionStorage.getItem('customTourBlocks');
      if (raw && (tourField || messageField)) {
        const data = JSON.parse(raw) as { text?: string; studio?: boolean };
        if (tourField) tourField.value = form.dataset.customTitle ?? '';
        if (messageField && data.text) messageField.value = data.studio ? data.text : `${form.dataset.builderPrefix}\n${data.text}`;
        sessionStorage.removeItem('customTourBlocks');
      }
    } catch {
      try {
        sessionStorage.removeItem('customTourBlocks');
      } catch {}
    }

    // Дата шоу не может быть в прошлом.
    form.querySelector<HTMLInputElement>('input[type="date"]')?.setAttribute('min', new Date().toISOString().slice(0, 10));

    // Нужен один способ связи: телефон, WhatsApp или почта. В разметке почта обязательна на случай работы
    // без JavaScript, а здесь это правило смягчается. Корпоративной форме почта нужна всегда.
    const eitherContact = form.dataset.variant !== 'corporate' && emailField !== null && phoneFields.length > 0;
    function checkContact() {
      if (!eitherContact || !emailField) return;
      const filled = [emailField, ...phoneFields].some((field) => field.value.trim());
      emailField.setCustomValidity(filled ? '' : (form.dataset.contactError ?? ''));
    }
    if (eitherContact && emailField) {
      emailField.required = false;
      form.addEventListener('input', checkContact);
      form.addEventListener('reset', () => setTimeout(checkContact));
      checkContact();
    }

    async function sendMail(data: Record<string, string>): Promise<boolean> {
      const res = await timedFetch(form.dataset.endpoint!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      return Boolean(json.success);
    }

    // Служебные поля Web3Forms и основные колонки таблицы; всё остальное — в data (jsonb).
    const SKIP = ['access_key', 'subject', 'from_name', 'botcheck'];
    const COLUMNS = ['name', 'email', 'phone', 'tour', 'message'];

    async function saveLead(data: Record<string, string>): Promise<boolean> {
      if (data.botcheck) return false; // ловушка для ботов
      const extra = Object.fromEntries(
        Object.entries(data).filter(([k, v]) => v && !SKIP.includes(k) && !COLUMNS.includes(k)),
      );
      const row = {
        form: form.dataset.variant,
        name: data.name || data.contact || null,
        email: data.email || null,
        phone: data.phone || data.whatsapp || null,
        tour: data.tour || null,
        message: data.message || null,
        data: { ...extra, ...landingInfo() },
        page: location.pathname,
        lang: form.dataset.lang,
      };
      const res = await timedFetch(form.dataset.db!, {
        method: 'POST',
        headers: { apikey: form.dataset.dbKey!, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify(row),
      });
      return res.ok;
    }

    function setStatus(text: string, type: 'success' | 'error' | '') {
      if (!status) return;
      status.textContent = text;
      status.dataset.type = type;
    }

    function showError() {
      setStatus(form.dataset.error ?? '', 'error');
      if (fallback) fallback.hidden = false;
    }

    const done = form.querySelector<HTMLElement>('[data-done]');
    const doneText = form.querySelector<HTMLElement>('[data-done-text]');

    // Вместо полей — блок «Заявка отправлена»; прокручиваем к нему, если он ушёл за экран.
    function showDone() {
      if (!done) return setStatus(form.dataset.success ?? '', 'success');
      form.classList.add('is-done');
      done.hidden = false;
      if (doneText) doneText.textContent = form.dataset.success ?? '';
      done.focus({ preventScroll: true });
      const box = done.getBoundingClientRect();
      if (box.top < 80 || box.bottom > innerHeight) {
        const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        done.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
      }
    }

    form.querySelector('[data-again]')?.addEventListener('click', () => {
      form.classList.remove('is-done');
      if (done) done.hidden = true;
      if (doneText) doneText.textContent = '';
      form.querySelector<HTMLElement>('input:not([type="hidden"]):not(.sr-only), textarea')?.focus();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!button || !label) return;
      const original = label.textContent;
      button.disabled = true;
      label.textContent = form.dataset.sending ?? '…';
      setStatus('', '');
      if (fallback) fallback.hidden = true;
      let accepted = false;

      try {
        const data = Object.fromEntries(
          Array.from(new FormData(form).entries(), ([k, v]) => [k, String(v).trim()]),
        ) as Record<string, string>;
        const filled = Object.fromEntries(Object.entries(data).filter(([, v]) => v));
        // Письмо на почту (Web3Forms) и запись в базу (Supabase) — параллельно.
        // Посетитель видит результат сразу после первого успешного ответа, второй запрос завершается сам.
        const mail = sendMail(filled);
        const db = saveLead(data);
        accepted = await firstOk([mail, db]);
        // Счётчик в Vercel Analytics: так видно, сколько заявок дошло и не отказал ли один из каналов.
        void Promise.allSettled([mail, db]).then(([m, d]) => {
          const ok = (r: PromiseSettledResult<boolean>) => r.status === 'fulfilled' && r.value;
          const channel = ok(m) && ok(d) ? 'both' : ok(m) ? 'mail' : ok(d) ? 'db' : 'none';
          track(channel === 'none' ? 'lead_failed' : 'lead_sent', { form: form.dataset.variant ?? '', channel });
        });
        if (accepted) {
          form.reset();
          showDone();
        } else {
          showError();
        }
      } catch {
        showError();
      } finally {
        button.disabled = false;
        label.textContent = original;
        if (!accepted) button.focus();
      }
    });
  });
</script>
