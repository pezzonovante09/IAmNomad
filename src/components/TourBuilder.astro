---
// Конструктор индивидуального тура: блоки добавляются кликом или перетаскиванием,
// порядок меняется перетаскиванием или кнопками ↑↓ (работает и на телефоне).
// По кнопке «Запросить» маршрут подставляется в форму на странице контактов.
import Icon from './Icon.astro';
import { builderItems } from '../data/tours';
import { localize, useTranslations, type Lang } from '../i18n/utils';
import { routes } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="builder" data-builder>
  <div class="builder__pool-wrap">
    <div class="builder__head">
      <h3 class="h3">{t('builder.poolTitle')}</h3>
      <p class="muted">{t('builder.poolHint')}</p>
    </div>
    <ul class="builder__pool">
      {
        builderItems.map((item) => (
          <li>
            <button
              type="button"
              class="bchip"
              draggable="true"
              data-add={item.id}
              data-icon={item.icon}
              data-label={t(`builder.item.${item.id}`)}
              aria-pressed="false"
            >
              <span class="bchip__icon" aria-hidden="true">
                {item.icon}
              </span>
              <span class="bchip__label">{t(`builder.item.${item.id}`)}</span>
              <span class="bchip__state" aria-hidden="true">
                <Icon name="plus" size={18} class="bchip__plus" />
                <Icon name="check" size={18} class="bchip__check" />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="builder__route-wrap">
    <div class="route" data-route-zone>
      <div class="route__head">
        <div>
          <h3 class="h3">{t('builder.routeTitle')}</h3>
          <p class="muted">{t('builder.routeHint')}</p>
        </div>
        <span class="route__count" aria-live="polite"><strong data-count>0</strong> {t('builder.blocks')}</span>
      </div>
      <ol class="route__list" data-route></ol>
      <p class="route__empty" data-empty>
        <Icon name="route" size={32} />
        {t('builder.empty')}
      </p>
      <div class="route__actions">
        <button type="button" class="btn btn--outline btn--sm" data-clear>
          <Icon name="trash" />
          {t('builder.clear')}
        </button>
        <a href={localize(routes.contact, lang)} class="btn btn--accent" data-submit aria-disabled="true">
          {t('builder.submit')}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </div>

  <template data-item-template>
    <li class="ritem" draggable="true">
      <span class="ritem__grip" aria-hidden="true"><Icon name="grip" size={18} /></span>
      <span class="ritem__num"></span>
      <span class="ritem__icon" aria-hidden="true"></span>
      <span class="ritem__label"></span>
      <span class="ritem__tools">
        <button type="button" class="ritem__btn" data-up aria-label={t('builder.moveUp')}><Icon name="arrow-up" size={16} /></button>
        <button type="button" class="ritem__btn" data-down aria-label={t('builder.moveDown')}><Icon name="arrow-down" size={16} /></button>
        <button type="button" class="ritem__btn ritem__btn--remove" data-remove aria-label={t('builder.remove')}><Icon name="x" size={16} /></button>
      </span>
    </li>
  </template>
</div>

<style>
  .builder {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }

  .builder__head {
    display: grid;
    gap: 4px;
    margin-bottom: 20px;
  }

  .builder__pool {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    list-style: none;
  }

  .builder__pool .bchip {
    border-top: 0;
    border-left: 0;
  }

  .bchip {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    height: 100%;
    padding: 12px 12px 12px 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    text-align: left;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
    cursor: grab;
    transition:
      border-color 0.2s,
      background-color 0.2s,
      transform 0.25s var(--ease),
      opacity 0.2s;
  }

  .bchip:hover {
    background: var(--bg);
  }

  .bchip__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 0;
    border: 1px solid var(--line-soft);
    font-size: 1.25rem;
  }

  .bchip__label {
    flex: 1;
  }

  .bchip__state {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 0;
    background: var(--bg-alt);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .bchip :global(.bchip__check) {
    display: none;
  }

  .bchip[aria-pressed='true'] {
    border-color: var(--success);
    background: color-mix(in srgb, var(--success) 7%, var(--surface));
    cursor: default;
  }

  .bchip[aria-pressed='true']:hover {
    transform: none;
  }

  .bchip[aria-pressed='true'] .bchip__state {
    background: var(--success);
    color: #fff;
  }

  .bchip[aria-pressed='true'] :global(.bchip__plus) {
    display: none;
  }

  .bchip[aria-pressed='true'] :global(.bchip__check) {
    display: block;
  }

  .bchip.is-dragging {
    opacity: 0.4;
  }

  /* ---------- Маршрут ---------- */
  .builder__route-wrap {
    position: sticky;
    top: calc(var(--header-h) + 16px);
  }

  .route {
    display: grid;
    gap: 16px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .route.is-over {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, var(--surface));
  }

  .route__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .route__head > div {
    display: grid;
    gap: 4px;
  }

  .route__count {
    flex-shrink: 0;
    padding: 6px 12px;
    border: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .route__list {
    display: grid;
    gap: 8px;
    list-style: none;
  }

  .route__list:empty {
    display: none;
  }

  .route__empty {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 32px 16px;
    border-radius: var(--radius);
    background: var(--bg-alt);
    color: var(--ink-mute);
    text-align: center;
    font-weight: 600;
  }

  .route__empty[hidden] {
    display: none;
  }

  .route__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .ritem {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 8px 8px 6px;
    background: var(--bg);
    border: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
    animation: ritem-in 0.35s var(--ease);
  }

  .ritem.is-dragging {
    opacity: 0.4;
  }

  .ritem.is-drop-before {
    box-shadow: 0 -3px 0 var(--accent);
  }

  .ritem.is-drop-after {
    box-shadow: 0 3px 0 var(--accent);
  }

  .ritem__grip {
    color: var(--ink-mute);
    cursor: grab;
  }

  .ritem__num {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .ritem__icon {
    font-size: 1.15rem;
  }

  .ritem__label {
    flex: 1;
    min-width: 0;
  }

  .ritem__tools {
    display: flex;
    gap: 2px;
  }

  .ritem__btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--ink-soft);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .ritem__btn:hover {
    background: var(--bg-alt);
    color: var(--ink);
  }

  .ritem__btn:disabled {
    opacity: 0.25;
    pointer-events: none;
  }

  .ritem__btn--remove:hover {
    background: color-mix(in srgb, var(--danger) 12%, transparent);
    color: var(--danger);
  }

  @keyframes ritem-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  @media (max-width: 900px) {
    .builder {
      grid-template-columns: 1fr;
    }

    .builder__route-wrap {
      position: static;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-builder]');
  if (root) {
    const pool = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-add]'));
    const list = root.querySelector<HTMLOListElement>('[data-route]')!;
    const zone = root.querySelector<HTMLElement>('[data-route-zone]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const submit = root.querySelector<HTMLAnchorElement>('[data-submit]')!;
    const template = root.querySelector<HTMLTemplateElement>('[data-item-template]')!;

    const meta = new Map(pool.map((b) => [b.dataset.add!, { icon: b.dataset.icon!, label: b.dataset.label! }]));
    let route: string[] = [];
    let drag: { id: string; from: 'pool' | 'route' } | null = null;

    function render() {
      list.replaceChildren(
        ...route.map((id, i) => {
          const li = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
          const m = meta.get(id)!;
          li.dataset.id = id;
          li.querySelector('.ritem__num')!.textContent = String(i + 1);
          li.querySelector('.ritem__icon')!.textContent = m.icon;
          li.querySelector('.ritem__label')!.textContent = m.label;
          li.querySelector<HTMLButtonElement>('[data-up]')!.disabled = i === 0;
          li.querySelector<HTMLButtonElement>('[data-down]')!.disabled = i === route.length - 1;
          return li;
        }),
      );
      pool.forEach((b) => b.setAttribute('aria-pressed', String(route.includes(b.dataset.add!))));
      empty.hidden = route.length > 0;
      count.textContent = String(route.length);
      submit.setAttribute('aria-disabled', String(route.length === 0));
    }

    function insert(id: string, index = route.length) {
      route = route.filter((x) => x !== id);
      route.splice(Math.min(index, route.length), 0, id);
      render();
    }

    function move(id: string, delta: number) {
      const i = route.indexOf(id);
      const j = i + delta;
      if (i < 0 || j < 0 || j >= route.length) return;
      [route[i], route[j]] = [route[j], route[i]];
      render();
      list.querySelector<HTMLButtonElement>(`[data-id="${id}"] ${delta < 0 ? '[data-up]' : '[data-down]'}`)?.focus();
    }

    // Клики
    pool.forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.add!;
        if (route.includes(id)) route = route.filter((x) => x !== id);
        else route.push(id);
        render();
      }),
    );

    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      const id = btn?.closest<HTMLElement>('.ritem')?.dataset.id;
      if (!btn || !id) return;
      if (btn.hasAttribute('data-remove')) {
        route = route.filter((x) => x !== id);
        render();
      } else if (btn.hasAttribute('data-up')) move(id, -1);
      else if (btn.hasAttribute('data-down')) move(id, 1);
    });

    root.querySelector('[data-clear]')?.addEventListener('click', () => {
      route = [];
      render();
    });

    submit.addEventListener('click', (e) => {
      if (!route.length) {
        e.preventDefault();
        return;
      }
      const labels = route.map((id) => meta.get(id)!.label);
      sessionStorage.setItem(
        'customTourBlocks',
        JSON.stringify({ ids: route, labels, text: labels.map((l, i) => `${i + 1}. ${l}`).join('\n') }),
      );
    });

    // Перетаскивание (мышь)
    function dropIndex(y: number): number {
      const items = Array.from(list.children) as HTMLElement[];
      const i = items.findIndex((el) => {
        const r = el.getBoundingClientRect();
        return y < r.top + r.height / 2;
      });
      return i === -1 ? items.length : i;
    }

    function clearMarkers() {
      list.querySelectorAll('.is-drop-before, .is-drop-after').forEach((el) => el.classList.remove('is-drop-before', 'is-drop-after'));
    }

    root.addEventListener('dragstart', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-add], .ritem');
      if (!el) return;
      const id = el.dataset.add ?? el.dataset.id!;
      drag = { id, from: el.classList.contains('ritem') ? 'route' : 'pool' };
      el.classList.add('is-dragging');
      e.dataTransfer!.effectAllowed = 'move';
      e.dataTransfer!.setData('text/plain', id);
    });

    root.addEventListener('dragend', (e) => {
      (e.target as HTMLElement).classList?.remove('is-dragging');
      zone.classList.remove('is-over');
      clearMarkers();
      drag = null;
    });

    zone.addEventListener('dragover', (e) => {
      if (!drag) return;
      e.preventDefault();
      zone.classList.add('is-over');
      clearMarkers();
      const i = dropIndex(e.clientY);
      const items = list.children;
      if (items[i]) items[i].classList.add('is-drop-before');
      else items[items.length - 1]?.classList.add('is-drop-after');
    });

    zone.addEventListener('dragleave', (e) => {
      if (!zone.contains(e.relatedTarget as Node)) {
        zone.classList.remove('is-over');
        clearMarkers();
      }
    });

    zone.addEventListener('drop', (e) => {
      e.preventDefault();
      if (!drag) return;
      let index = dropIndex(e.clientY);
      if (drag.from === 'route') {
        const from = route.indexOf(drag.id);
        if (from !== -1 && from < index) index -= 1;
      }
      insert(drag.id, index);
    });

    render();
  }
</script>
