---
import Icon from './Icon.astro';
import { contacts } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<a href={contacts.whatsapp} class="wa" target="_blank" rel="noopener" aria-label={t('ui.whatsappChat')}>
  <Icon name="whatsapp" size={22} />
  <span class="wa__label">WhatsApp</span>
</a>

<style>
  .wa {
    position: fixed;
    right: max(40px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 16px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.5s,
      color 0.5s,
      border-color 0.5s,
      bottom 0.4s var(--ease);
  }

  .wa:hover {
    background: #25d366;
    border-color: #25d366;
    color: #06351a;
  }

  @media (max-width: 640px) {
    .wa__label {
      display: none;
    }

    .wa {
      right: max(16px, env(safe-area-inset-right));
      width: 48px;
      padding: 0;
      justify-content: center;
    }
  }

  :global(body.has-bookbar) .wa {
    bottom: calc(max(16px, env(safe-area-inset-bottom)) + 76px);
  }

  @media (min-width: 1025px) {
    :global(body.has-bookbar) .wa {
      bottom: max(16px, env(safe-area-inset-bottom));
    }
  }
</style>
