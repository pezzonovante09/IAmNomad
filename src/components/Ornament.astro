---
// Кыргызские мотивы:
//  - horn   — «кочкор мүйүз» (рога барана), знак бренда и индикатор прокрутки;
//  - tunduk — тюндюк, круг свода юрты: решётка из трёх и трёх дуг + лучи.
interface Props {
  variant: 'horn' | 'tunduk';
  class?: string;
  size?: number;
  stroke?: string;
}

const { variant, class: className, size, stroke = 'currentColor' } = Astro.props;

const bars = [-14, 0, 14].map((o) => {
  const h = Math.sqrt(40 * 40 - o * o);
  return { o, h };
});
const rays = Array.from({ length: 24 }, (_, i) => {
  const a = (i * Math.PI) / 12;
  return { x1: 60 + Math.cos(a) * 44, y1: 60 + Math.sin(a) * 44, x2: 60 + Math.cos(a) * 52, y2: 60 + Math.sin(a) * 52 };
});
---

{
  variant === 'horn' ? (
    <svg class={className} viewBox="0 0 56 28" width={size ? size * 2 : 28} height={size ?? 14} fill="none" aria-hidden="true">
      <path
        d="M28 28V16C28 6 42 4 46 12C49 18 42 22 38 17C35 13 40 10 42 13M28 16C28 6 14 4 10 12C7 18 14 22 18 17C21 13 16 10 14 13"
        stroke={stroke}
        stroke-width="3"
      />
    </svg>
  ) : (
    <svg class={className} viewBox="0 0 120 120" width={size} height={size} fill="none" stroke={stroke} aria-hidden="true">
      <circle cx="60" cy="60" r="40" stroke-width="1.5" />
      {bars.map(({ o, h }) => (
        <>
          <line x1={60 + o} y1={60 - h} x2={60 + o} y2={60 + h} stroke-width="1.5" />
          <line x1={60 - h} y1={60 + o} x2={60 + h} y2={60 + o} stroke-width="1.5" />
        </>
      ))}
      {rays.map((r) => (
        <line {...r} stroke-width="1" />
      ))}
      <circle cx="60" cy="60" r="55" stroke-width="1" opacity="0.45" />
    </svg>
  )
}
