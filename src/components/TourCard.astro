---
import Icon from './Icon.astro';
import type { Tour } from '../data/tours';
import { localize, useTranslations, type Lang } from '../i18n/utils';
import { srcset, unsplash } from '../lib/img';
import { routes } from '../lib/routes';

interface Props {
  tour: Tour;
  lang: Lang;
  index?: number;
  compact?: boolean;
}

const { tour, lang, index = 0, compact = false } = Astro.props;
const t = useTranslations(lang);
const k = (field: string) => t(`${tour.card}.${field}`);
const href = localize(routes.tour(tour.slug), lang);
const categoryLabel = t(`tours.tab.${tour.category}`);
const statusBadge = tour.status === 'soon' ? t('btn.comingSoon') : null;
---

<article class:list={['tc', { 'tc--compact': compact }]} data-category={tour.category} data-reveal style={`--i:${index}`}>
  <a href={href} class="tc__media" tabindex="-1" aria-hidden="true">
    <img
      src={unsplash(tour.cover.id, 800, 1000)}
      srcset={srcset(tour.cover.id, [400, 600, 800, 1000], 1.25)}
      sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 25vw"
      alt=""
      width="800"
      height="1000"
      loading="lazy"
      decoding="async"
    />
    <span class="tc__badges">
      <span class="badge">{categoryLabel}</span>
      {statusBadge && <span class="badge badge--gold">{statusBadge}</span>}
    </span>
  </a>
  <div class="tc__body">
    <p class="tc__meta">
      <span><Icon name="clock" size={16} />{k('duration')}</span>
      <span><Icon name="pin" size={16} />{k('location')}</span>
    </p>
    <h3 class="tc__title">
      <a href={href}>{k('title')}</a>
    </h3>
    {!compact && <p class="tc__excerpt">{k('excerpt')}</p>}
    <div class="tc__foot">
      <p class="tc__price">
        {tour.status === 'open' && <small>{t('misc.from')}</small>}
        {k('price')}
      </p>
      <span class="tc__go" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
    </div>
  </div>
</article>

<style>
  .tc {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      border-color 0.3s;
  }

  .tc:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }

  .tc__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .tc--compact .tc__media {
    aspect-ratio: 4 / 3;
  }

  .tc__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }

  .tc:hover .tc__media img {
    transform: scale(1.06);
  }

  .tc__badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tc__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
    padding: 20px 22px 22px;
  }

  .tc__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-mute);
  }

  .tc__meta span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .tc__title {
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .tc__title a {
    text-decoration: none;
  }

  /* вся карточка кликабельна */
  .tc__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .tc__excerpt {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .tc__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
  }

  .tc__price {
    display: grid;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.1;
  }

  .tc__price small {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .tc__go {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg-alt);
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.4s var(--ease);
  }

  .tc:hover .tc__go {
    background: var(--accent);
    color: var(--on-accent);
    transform: rotate(-45deg);
  }

  .tc.is-hidden {
    display: none;
  }
</style>
