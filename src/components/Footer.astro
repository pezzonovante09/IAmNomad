---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Ornament from './Ornament.astro';
import { contacts } from '../data/site';
import { tours } from '../data/tours';
import { localize, useTranslations, type Lang } from '../i18n/utils';
import { navItems, routes } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contactLinks = [
  { icon: 'whatsapp', label: t('footer.whatsapp'), value: contacts.phone, href: contacts.whatsapp },
  { icon: 'telegram', label: t('footer.telegram'), value: contacts.telegramHandle, href: contacts.telegram },
  { icon: 'mail', label: t('footer.email'), value: contacts.email, href: `mailto:${contacts.email}` },
  { icon: 'phone', label: t('footer.phone'), value: contacts.phone, href: contacts.phoneHref },
] as const;

const socials = [
  { icon: 'instagram', label: 'Instagram', href: contacts.instagram },
  { icon: 'facebook', label: 'Facebook', href: contacts.facebook },
  { icon: 'youtube', label: 'YouTube', href: contacts.youtube },
] as const;
---

<footer class="footer">
  <div class="ornament-band footer__band" aria-hidden="true"></div>
  <Ornament variant="rosette" class="footer__rosette" />
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo lang={lang} />
      <p class="footer__slogan">{t('brand.slogan')}</p>
      <p class="footer__mission">{t('about.mission.text')}</p>
      <div class="footer__social">
        {
          socials.map((s) => (
            <a href={s.href} aria-label={s.label} target="_blank" rel="noopener">
              <Icon name={s.icon} size={20} />
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <h2 class="footer__title">{t('footer.quickLinks')}</h2>
      <ul class="footer__links">
        <li><a href={localize('/', lang)}>{t('nav.home')}</a></li>
        {navItems.map((item) => <li><a href={localize(item.href, lang)}>{t(item.label)}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer__title">{t('nav.tours')}</h2>
      <ul class="footer__links">
        {tours.map((tour) => <li><a href={localize(routes.tour(tour.slug), lang)}>{t(`${tour.card}.title`)}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer__title">{t('footer.contact')}</h2>
      <ul class="footer__contacts">
        {
          contactLinks.map((c) => (
            <li>
              <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                <Icon name={c.icon} size={18} />
                <span>
                  <small>{c.label}</small>
                  {c.value}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <p>{t('footer.copyright')}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding-bottom: 24px;
    background: #17120e;
    color: #e9e0d2;
  }

  .footer__band {
    color: var(--gold);
    opacity: 0.8;
  }

  .footer__rosette {
    position: absolute;
    right: -120px;
    bottom: -120px;
    width: 420px;
    height: 420px;
    color: #f4eee4;
    opacity: 0.04;
    pointer-events: none;
  }

  .footer__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: 40px;
    padding-block: clamp(56px, 7vw, 88px) 48px;
  }

  .footer__brand :global(.logo) {
    color: #fffaf2;
  }

  .footer__slogan {
    margin-top: 24px;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: #fffaf2;
  }

  .footer__mission {
    margin-top: 10px;
    max-width: 34ch;
    font-size: 0.95rem;
    color: #b3a894;
  }

  .footer__social {
    display: flex;
    gap: 10px;
    margin-top: 24px;
  }

  .footer__social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid #3d342b;
    border-radius: 50%;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .footer__social a:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: #2a1c04;
  }

  .footer__title {
    margin-bottom: 18px;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .footer__links {
    display: grid;
    gap: 10px;
    list-style: none;
  }

  .footer__links a {
    color: #d8cebf;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__links a:hover {
    color: #fff;
  }

  .footer__contacts {
    display: grid;
    gap: 14px;
    list-style: none;
  }

  .footer__contacts a {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: #f1e9dc;
    text-decoration: none;
    word-break: break-word;
  }

  .footer__contacts a :global(svg) {
    margin-top: 3px;
    color: var(--gold);
    flex-shrink: 0;
  }

  .footer__contacts small {
    display: block;
    font-size: 0.75rem;
    color: #9d917e;
  }

  .footer__contacts a:hover span {
    text-decoration: underline;
  }

  .footer__bottom {
    position: relative;
    padding-top: 24px;
    border-top: 1px solid #2e2620;
    font-size: 0.85rem;
    color: #8f846f;
  }

  @media (max-width: 960px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
