---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { contacts } from '../data/site';
import { languages, localize, useTranslations, type Lang } from '../i18n/utils';
import { navItems, routes } from '../lib/routes';

interface Props {
  lang: Lang;
  active?: string;
  /** Путь текущей страницы без языкового префикса — для переключателя языка. */
  path: string;
}

const { lang, active, path } = Astro.props;
const t = useTranslations(lang);
const bookHref = active === 'home' ? '#contact-form' : localize(routes.contact, lang);
const menuItems = [{ key: 'home', href: '/', label: 'nav.home' }, ...navItems];
const pad = (n: number) => String(n).padStart(2, '0');
---

<header class="hd" data-header>
  <Logo lang={lang} class="hd__cell hd__logo" />
  <a href={localize(routes.show, lang)} class="hd__cell hd__show" aria-current={active === 'show' ? 'page' : undefined}>
    <span class="hd__show-dot" aria-hidden="true"></span>I AM NOMAD SHOW
  </a>
  <a href={bookHref} class="hd__cell hd__book">{t('btn.bookNow')}</a>
  <button class="hd__menu" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
    <span class="hd__menu-label" data-open={t('ui.menu')} data-close={t('ui.close')}>{t('ui.menu')}</span>
    <span class="hd__burger" aria-hidden="true"><span></span><span></span></span>
  </button>
  <div class="hd__cell hd__lang" role="group" aria-label={t('ui.language')}>
    {
      (Object.keys(languages) as Lang[]).map((code) => (
        <a href={localize(path, code)} hreflang={code} lang={code} aria-current={code === lang ? 'true' : undefined}>
          {languages[code]}
        </a>
      ))
    }
  </div>
  <button class="hd__cell hd__theme" type="button" data-theme-toggle aria-label={t('theme.toggle')}>
    <Icon name="moon" class="theme-moon" size={18} />
    <Icon name="sun" class="theme-sun" size={18} />
  </button>
</header>

<div class="mn" id="site-menu" data-menu hidden>
  <nav class="mn__nav" aria-label="Main">
    <ol class="mn__list">
      {
        menuItems.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={localize(item.href, lang)} class="mn__link" aria-current={active === item.key ? 'page' : undefined}>
              <span class="mn__num label num">({pad(i + 1)})</span>
              <span class="mn__title">{t(item.label)}</span>
              <span class="mn__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="mn__side">
    <p class="label">{t('footer.contact')}</p>
    <ul class="mn__contacts">
      <li><a href={contacts.whatsapp} target="_blank" rel="noopener">WhatsApp — {contacts.phone}</a></li>
      <li><a href={contacts.telegram} target="_blank" rel="noopener">Telegram — {contacts.telegramHandle}</a></li>
      <li><a href={`mailto:${contacts.email}`}>{contacts.email}</a></li>
    </ul>
    <button class="mn__theme label" type="button" data-theme-toggle>
      <Icon name="moon" class="theme-moon" size={16} />
      <Icon name="sun" class="theme-sun" size={16} />
      {t('theme.toggle')}
    </button>
    <a href={bookHref} class="btn btn--accent btn--block">
      {t('btn.bookNow')}
      <Icon name="arrow-right" />
    </a>
  </div>
</div>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: stretch;
    min-height: var(--header-h);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    transition: transform 0.4s var(--ease);
  }

  .hd.is-hidden {
    transform: translateY(-100%);
  }

  .hd__cell {
    display: flex;
    align-items: center;
    padding: 0 24px;
    border-right: 1px solid var(--line);
  }

  /* Логотип занимает всё свободное место — остальные ячейки прижаты вправо */
  .hd :global(.hd__logo) {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Язык и тема — у самого правого края */
  .hd__lang {
    gap: 4px;
    padding: 0 16px;
  }

  .hd__theme {
    border-right: 0;
  }

  .hd__lang a {
    padding: 4px 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-decoration: none;
    opacity: 0.5;
  }

  .hd__lang a[aria-current] {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hd__theme {
    justify-content: center;
    padding: 0 16px;
    border-top: 0;
    border-bottom: 0;
    border-left: 0;
    background: transparent;
  }

  .hd__theme:hover {
    background: var(--surface);
  }

  .theme-sun {
    display: none;
  }

  :global([data-theme='dark']) .theme-sun {
    display: block;
  }

  :global([data-theme='dark']) .theme-moon {
    display: none;
  }

  .hd__book {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.5s,
      color 0.5s;
  }

  /* Отдельное направление — золотая ячейка */
  .hd__show {
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.5s,
      color 0.5s;
  }

  .hd__show-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    animation: show-dot 2s ease-out infinite;
  }

  .hd__show:hover,
  .hd__show[aria-current='page'] {
    background: var(--gold);
    color: #111;
  }

  .hd__show:hover .hd__show-dot,
  .hd__show[aria-current='page'] .hd__show-dot {
    background: #111;
  }

  @keyframes show-dot {
    0% {
      box-shadow: 0 0 0 0 rgb(197 160 89 / 0.7);
    }
    100% {
      box-shadow: 0 0 0 8px rgb(197 160 89 / 0);
    }
  }

  .hd__book:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .hd__menu {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 28px;
    border: 0;
    background: var(--ink);
    color: var(--bg);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: background-color 0.5s;
  }

  .hd__menu:hover,
  .hd__menu[aria-expanded='true'] {
    background: var(--accent);
    color: var(--on-accent);
  }

  .hd__burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .hd__burger span {
    display: block;
    width: 22px;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }

  [aria-expanded='true'] .hd__burger span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  [aria-expanded='true'] .hd__burger span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 1100px) {
    .hd__book {
      display: none;
    }

    .hd :global(.logo__tagline) {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hd__show {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .hd :global(.hd__logo) {
      padding: 0 16px;
    }

    .hd__menu {
      padding: 0 16px;
    }

    .hd__menu-label {
      display: none;
    }
  }

  /* Узкие телефоны: тема переезжает в меню, отступы плотнее */
  @media (max-width: 480px) {
    .hd__theme {
      display: none;
    }

    .hd :global(.hd__logo) {
      min-width: 0;
      padding: 0 12px;
    }

    .hd__lang {
      padding: 0 8px;
    }

    .hd__lang a {
      padding: 4px;
    }
  }

  /* ---------- Меню ---------- */
  .mn {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 49;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
    overflow-y: auto;
    background: var(--bg);
    animation: mn-in 0.7s cubic-bezier(0.77, 0, 0.18, 1);
  }

  .mn[hidden] {
    display: none;
  }

  .mn__list {
    list-style: none;
  }

  .mn__list li {
    border-bottom: 1px solid var(--line);
    animation: mn-item 0.8s var(--ease) both;
    animation-delay: calc(120ms + var(--i) * 45ms);
  }

  .mn__link {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 14px var(--gutter);
    text-decoration: none;
    transition:
      background-color 0.5s,
      color 0.5s;
  }

  .mn__list li:has([href$='/show/']) .mn__title::after {
    content: '';
    display: inline-block;
    width: 0.28em;
    height: 0.28em;
    margin-left: 0.3em;
    border-radius: 50%;
    background: var(--gold);
    vertical-align: 0.5em;
  }

  .mn__link:hover,
  .mn__link[aria-current='page'] {
    background: var(--accent);
    color: var(--on-accent);
  }

  .mn__num {
    width: 44px;
    flex-shrink: 0;
  }

  .mn__title {
    flex: 1;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 4.4vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .mn__arrow {
    font-size: 24px;
    opacity: 0;
    transform: translateX(-12px);
    transition:
      opacity 0.4s,
      transform 0.4s var(--ease);
  }

  .mn__link:hover .mn__arrow {
    opacity: 1;
    transform: none;
  }

  .mn__side {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px var(--gutter);
    border-left: 1px solid var(--line);
    background: var(--surface);
  }

  .mn__contacts {
    display: grid;
    gap: 10px;
    list-style: none;
  }

  .mn__contacts a {
    text-decoration: none;
  }

  .mn__contacts a:hover {
    text-decoration: underline;
  }

  .mn__theme {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
    padding: 10px 14px;
    border: 1px solid var(--line);
    background: transparent;
  }

  .mn__side .btn {
    margin-top: auto;
  }

  @media (max-width: 760px) {
    .mn {
      grid-template-columns: minmax(0, 1fr);
    }

    .mn__side {
      border-left: 0;
    }

    .mn__num {
      width: 36px;
    }
  }

  @keyframes mn-in {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes mn-item {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = toggle?.querySelector<HTMLElement>('.hd__menu-label');

  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    if (label) label.textContent = (open ? label.dataset.close : label.dataset.open) ?? '';
    document.body.classList.toggle('is-locked', open);
    header?.classList.remove('is-hidden');
    // Пока меню открыто, фокус остаётся в шапке и меню: остальная страница недоступна.
    Array.from(document.body.children).forEach((el) => {
      if (el !== header && el !== menu && el.tagName !== 'SCRIPT') (el as HTMLElement).inert = open;
    });
    if (open) {
      (window as any).__fit?.(menu);
      menu.querySelector<HTMLElement>('a')?.focus();
    } else if (wasOpen && menu.contains(document.activeElement)) toggle.focus();
  }

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  // Шапка прячется при прокрутке вниз и возвращается при прокрутке вверх.
  let lastY = scrollY;
  addEventListener(
    'scroll',
    () => {
      const y = scrollY;
      const open = toggle?.getAttribute('aria-expanded') === 'true';
      header?.classList.toggle('is-hidden', !open && y > 400 && y > lastY);
      lastY = y;
    },
    { passive: true },
  );

  document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme !== 'dark';
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
    }),
  );
</script>
