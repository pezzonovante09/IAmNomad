---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { contacts } from '../data/site';
import { languages, localize, useTranslations, type Lang } from '../i18n/utils';
import { navItems, routes } from '../lib/routes';

interface Props {
  lang: Lang;
  active?: string;
  /** Путь текущей страницы без языкового префикса — для переключателя языка. */
  path: string;
  /** Прозрачная шапка поверх героя (главная). */
  overlay?: boolean;
}

const { lang, active, path, overlay = false } = Astro.props;
const t = useTranslations(lang);
const bookHref = active === 'home' ? '#contact-form' : localize(routes.contact, lang);
---

<header class="header" data-header data-overlay={overlay ? '' : undefined}>
  <div class="container header__inner">
    <Logo lang={lang} />

    <nav class="header__nav" aria-label="Main">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={localize(item.href, lang)}
                class="header__link"
                aria-current={active === item.key ? 'page' : undefined}
              >
                {t(item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <div class="lang" role="group" aria-label={t('ui.language')}>
        {
          (Object.keys(languages) as Lang[]).map((code) => (
            <a
              href={localize(path, code)}
              hreflang={code}
              lang={code}
              class="lang__item"
              aria-current={code === lang ? 'true' : undefined}
            >
              {languages[code]}
            </a>
          ))
        }
      </div>
      <button class="header__icon" type="button" data-theme-toggle aria-label={t('theme.toggle')}>
        <Icon name="moon" class="theme-moon" size={20} />
        <Icon name="sun" class="theme-sun" size={20} />
      </button>
      <a href={bookHref} class="btn btn--accent btn--sm header__cta">{t('btn.bookNow')}</a>
      <button
        class="header__icon header__burger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">{t('ui.menu')}</span>
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="mobile-menu" data-menu hidden>
  <nav class="container menu__inner" aria-label="Mobile">
    <ul class="menu__list">
      <li style="--i:0">
        <a href={localize('/', lang)} class="menu__link" aria-current={active === 'home' ? 'page' : undefined}>
          {t('nav.home')}
        </a>
      </li>
      {
        navItems.map((item, i) => (
          <li style={`--i:${i + 1}`}>
            <a
              href={localize(item.href, lang)}
              class="menu__link"
              aria-current={active === item.key ? 'page' : undefined}
            >
              {t(item.label)}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu__footer">
      <a href={bookHref} class="btn btn--accent btn--block" data-menu-close>{t('btn.bookNow')}</a>
      <a href={contacts.whatsapp} class="btn btn--outline btn--block" target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        {contacts.phone}
      </a>
    </div>
  </nav>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    color: var(--ink);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s,
      transform 0.35s var(--ease);
  }

  .header[data-overlay] {
    position: fixed;
    inset: 0 0 auto;
  }

  .header[data-overlay]:not(.is-scrolled):not(.is-menu-open) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-color: transparent;
    color: var(--hero-ink);
  }

  .header.is-hidden {
    transform: translateY(-100%);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 100%;
  }

  .header__nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
  }

  .header__link {
    position: relative;
    display: block;
    padding: 8px 12px;
    font-size: 0.93rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 999px;
    transition: background-color 0.2s;
  }

  .header__link:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .header__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 1px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
    transform: translateX(-50%);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang {
    display: flex;
    padding: 3px;
    border: 1.5px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 999px;
  }

  .lang__item {
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-decoration: none;
    opacity: 0.7;
  }

  .lang__item[aria-current] {
    background: var(--ink);
    color: var(--bg);
    opacity: 1;
  }

  .header[data-overlay]:not(.is-scrolled):not(.is-menu-open) .lang__item[aria-current] {
    background: var(--hero-ink);
    color: #1f1a15;
  }

  .header__icon {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    transition: background-color 0.2s;
  }

  .header__icon:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .theme-sun {
    display: none;
  }

  :global([data-theme='dark']) .theme-sun {
    display: block;
  }

  :global([data-theme='dark']) .theme-moon {
    display: none;
  }

  .burger {
    display: grid;
    gap: 6px;
    width: 20px;
  }

  .burger span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }

  .burger span:last-child {
    width: 70%;
    justify-self: end;
    transition:
      transform 0.3s var(--ease),
      width 0.3s var(--ease);
  }

  [aria-expanded='true'] .burger span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  [aria-expanded='true'] .burger span:last-child {
    width: 100%;
    transform: translateY(-4px) rotate(-45deg);
  }

  .header__burger {
    display: none;
  }

  @media (max-width: 1180px) {
    .header__nav {
      display: none;
    }

    .header__burger {
      display: inline-grid;
    }
  }

  @media (max-width: 560px) {
    .header__cta {
      display: none;
    }

    .header__inner {
      gap: 8px;
    }

    .header__actions {
      gap: 0;
    }

    .lang__item {
      padding: 4px 7px;
    }
  }

  /* ---------- мобильное меню ---------- */
  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 49;
    overflow-y: auto;
    background: var(--bg);
    animation: menu-in 0.35s var(--ease);
  }

  .menu[hidden] {
    display: none;
  }

  .menu__inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-block: 24px 32px;
  }

  .menu__list {
    list-style: none;
  }

  .menu__list li {
    border-bottom: 1px solid var(--line);
    animation: menu-item 0.5s var(--ease) both;
    animation-delay: calc(var(--i) * 35ms);
  }

  .menu__link {
    display: block;
    padding: 14px 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 5vw, 1.7rem);
    font-weight: 600;
    text-decoration: none;
  }

  .menu__link[aria-current='page'] {
    color: var(--accent);
  }

  .menu__footer {
    display: grid;
    gap: 12px;
    margin-top: auto;
    padding-top: 32px;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  function setMenu(open: boolean) {
    if (!toggle || !menu || !header) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    header.classList.toggle('is-menu-open', open);
    document.body.classList.toggle('is-locked', open);
  }

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
  window.matchMedia('(min-width: 1181px)').addEventListener('change', (e) => e.matches && setMenu(false));

  // Шапка: фон после прокрутки, прячется при скролле вниз.
  let lastY = window.scrollY;
  function onScroll() {
    if (!header) return;
    const y = window.scrollY;
    header.classList.toggle('is-scrolled', y > 24);
    const menuOpen = toggle?.getAttribute('aria-expanded') === 'true';
    header.classList.toggle('is-hidden', !menuOpen && y > 320 && y > lastY);
    lastY = y;
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Тема
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const dark = document.documentElement.dataset.theme !== 'dark';
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {}
    }),
  );
</script>
