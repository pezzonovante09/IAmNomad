---
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class="video" data-reveal>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
    allowfullscreen></iframe>
</div>

<style>
  .video {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    background: var(--bg-alt);
  }

  .video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
