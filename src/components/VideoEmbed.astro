---
// Видео: файл (/video/x.mp4, постер — /video/x.jpg рядом) или встраивание (YouTube и т.п.).
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
const isFile = /\.(mp4|webm)(\?|$)/i.test(src);
const poster = src.replace(/\.(mp4|webm)(\?.*)?$/i, '.jpg');
---

<div class="video" data-reveal>
  {
    isFile ? (
      <video src={src} poster={poster} controls playsinline preload="metadata" aria-label={title}></video>
    ) : (
      <iframe
        src={src}
        title={title}
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        allowfullscreen
      />
    )
  }
</div>

<style>
  .video {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    background: var(--bg-alt);
  }

  .video iframe,
  .video video {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
