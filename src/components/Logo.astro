---
import Ornament from './Ornament.astro';
import { localize, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<a href={localize('/', lang)} class:list={['logo', className]} aria-label={`${t('brand.name')} — ${t('nav.home')}`}>
  <span class="logo__mark"><Ornament variant="tunduk" size={30} /></span>
  <span class="logo__text">
    <span class="logo__name">I AM NOMAD</span>
    <span class="logo__tagline">{t('brand.tagline')}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  .logo__mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--gold);
    color: #3b1f06;
    transition: transform 0.6s var(--ease);
  }

  .logo:hover .logo__mark {
    transform: rotate(90deg);
  }

  .logo__text {
    display: grid;
    line-height: 1;
  }

  .logo__name {
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .logo__tagline {
    margin-top: 4px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .logo__tagline {
      display: none;
    }
  }
</style>
