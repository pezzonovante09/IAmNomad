---
import Ornament from './Ornament.astro';
import { localize, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<a href={localize('/', lang)} class:list={['logo', className]} aria-label={`I AM NOMAD — ${t('nav.home')}`}>
  <Ornament variant="horn" size={14} class="logo__mark" />
  <span class="logo__name">I AM NOMAD</span>
  <span class="logo__tagline">{t('brand.tagline')}</span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }

  .logo__mark {
    color: var(--accent);
    flex-shrink: 0;
  }

  .logo__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .logo__tagline {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .logo__tagline {
      display: none;
    }
  }
</style>
