---
// Логотип компании: «I AM» золотым, «NOMAD» зелёным, «O» — кольцо с золотой точкой,
// под ним TRAVEL & DISCOVER. Собран из текста и CSS — чёткий на любом экране.
import { localize, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
  /** Без подписи TRAVEL & DISCOVER. */
  compact?: boolean;
}

const { lang, class: className, compact = false } = Astro.props;
const t = useTranslations(lang);
---

<a href={localize('/', lang)} class:list={['logo', className]} aria-label={`I AM NOMAD — ${t('nav.home')}`}>
  <span class="logo__lockup" aria-hidden="true">
    <span class="logo__word">
      <span class="logo__iam">I AM</span>
      <span class="logo__nomad">N<span class="logo__o"></span>MAD</span>
    </span>
    {!compact && <span class="logo__tagline">Travel &amp; Discover</span>}
  </span>
</a>

<style>
  .logo {
    --logo-gold: #e4ae25;
    --logo-green: #07703f;
    display: flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  :global([data-theme='dark']) .logo {
    --logo-green: #1f9e5e;
  }

  .logo__lockup {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1px;
  }

  .logo__word {
    display: flex;
    gap: 0.3em;
    font-family: 'Montserrat', var(--font-display);
    font-weight: 800;
    font-size: 22px;
    line-height: 1;
    letter-spacing: 0.005em;
    white-space: nowrap;
  }

  .logo__iam {
    color: var(--logo-gold);
  }

  .logo__nomad {
    color: var(--logo-green);
  }

  /* «O»: зелёное кольцо высотой с заглавную букву и золотая точка внутри */
  .logo__o {
    display: inline-block;
    width: 0.72em;
    height: 0.7em;
    margin: 0 0.04em;
    border: 0.16em solid currentColor;
    border-radius: 50%;
    box-sizing: border-box;
    background: radial-gradient(circle, var(--logo-gold) 0 0.1em, transparent 0.108em);
    vertical-align: baseline;
  }

  .logo__tagline {
    display: flex;
    justify-content: space-between;
    color: var(--logo-green);
    font-family: 'Montserrat', var(--font-display);
    font-weight: 600;
    font-size: 7.5px;
    line-height: 1;
    letter-spacing: 0.5em;
    margin-right: -0.5em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
