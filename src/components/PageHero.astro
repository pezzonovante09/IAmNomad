---
// Шапка внутренних страниц: заголовок на тёплом фоне с орнаментом или на фото.
import Ornament from './Ornament.astro';
import { srcset, unsplash, type Photo } from '../lib/img';

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  photo?: Photo;
}

const { title, subtitle, eyebrow, photo } = Astro.props;
---

<section class:list={['ph', { 'ph--photo': photo }]}>
  {
    photo && (
      <img
        class="ph__bg"
        src={unsplash(photo.id, 1600, 700)}
        srcset={srcset(photo.id, [800, 1200, 1600, 2200], 0.44)}
        sizes="100vw"
        alt=""
        width="1600"
        height="700"
        fetchpriority="high"
      />
    )
  }
  {!photo && <Ornament variant="rosette" class="ph__rosette" />}
  <div class="container ph__inner">
    {eyebrow && <p class="eyebrow ph__eyebrow">{eyebrow}</p>}
    <h1 class="h1 ph__title">{title}</h1>
    {subtitle && <p class="lead ph__subtitle">{subtitle}</p>}
    <slot />
  </div>
  <div class="ornament-band ph__band" aria-hidden="true"></div>
</section>

<style>
  .ph {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 8vw, 112px) clamp(48px, 6vw, 88px);
    background: var(--bg-alt);
  }

  .ph__rosette {
    position: absolute;
    top: 50%;
    right: -60px;
    width: clamp(260px, 36vw, 480px);
    height: auto;
    color: var(--accent);
    opacity: 0.08;
    transform: translateY(-50%);
    animation: ph-spin 120s linear infinite;
  }

  .ph__inner {
    position: relative;
    display: grid;
    gap: 16px;
  }

  .ph__title {
    max-width: 18ch;
  }

  .ph__subtitle {
    max-width: 60ch;
  }

  .ph__band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0.35;
  }

  .ph--photo {
    min-height: min(62vh, 560px);
    display: flex;
    align-items: flex-end;
    color: var(--hero-ink);
    background: #1b140e;
  }

  .ph--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--overlay);
  }

  .ph__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ph--photo .ph__inner {
    z-index: 1;
  }

  .ph--photo .ph__subtitle {
    color: rgb(255 250 242 / 0.85);
  }

  .ph--photo .ph__eyebrow {
    color: var(--gold);
  }

  .ph--photo .ph__band {
    z-index: 1;
    color: var(--gold);
    opacity: 0.7;
  }

  @keyframes ph-spin {
    to {
      transform: translateY(-50%) rotate(360deg);
    }
  }
</style>
