---
// Индикатор прокрутки справа: вертикальная линия и едущий по ней знак «рога барана».
import Ornament from './Ornament.astro';
---

<div class="sp" aria-hidden="true">
  <div class="sp__line">
    <div class="sp__mark" data-sp-mark>
      <Ornament variant="horn" size={11} stroke="#C5A059" />
    </div>
  </div>
</div>

<style>
  .sp {
    position: fixed;
    right: 10px;
    top: 50%;
    z-index: 30;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 22px;
    height: 200px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .sp__line {
    position: relative;
    flex: 1;
    width: 1px;
    background: var(--line);
  }

  .sp__mark {
    position: absolute;
    left: 50%;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 14px;
    background: var(--bg);
    transform: translate(-50%, -50%);
  }

  @media (max-width: 900px) {
    .sp {
      display: none;
    }
  }
</style>

<script>
  const mark = document.querySelector<HTMLElement>('[data-sp-mark]');
  if (mark) {
    const update = () => {
      const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      mark.style.top = `${Math.min(100, (scrollY / max) * 100)}%`;
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
