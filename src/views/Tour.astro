  }

  .incl__col ul {
    list-style: none;
  }

  .incl__col li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .incl__label {
    margin-bottom: 4px;
    color: var(--ink-mute);
  }

  .incl__col :global(.incl__yes) {
