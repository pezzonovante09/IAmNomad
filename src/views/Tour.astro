</style>

<script>
  // Развернуть/свернуть все дни программы
  const expandBtn = document.querySelector<HTMLButtonElement>('[data-expand-all]');
  const days = document.querySelectorAll<HTMLDetailsElement>('.day');
  expandBtn?.addEventListener('click', () => {
    const open = Array.from(days).some((d) => !d.open);
    days.forEach((d) => (d.open = open));
    expandBtn.textContent = (open ? expandBtn.dataset.collapse : expandBtn.dataset.expand) ?? '';
  });

  // Нижняя панель бронирования после героя
  const bar = document.querySelector<HTMLElement>('[data-bookbar]');
  const trigger = document.querySelector('[data-bookbar-trigger]');
  if (bar && trigger) {
    document.body.classList.add('has-bookbar');
    new IntersectionObserver(([entry]) => {
      const visible = !entry.isIntersecting;
      bar.classList.toggle('is-visible', visible);
      bar.setAttribute('aria-hidden', String(!visible));
      bar.querySelectorAll('a').forEach((a) => (a.tabIndex = visible ? 0 : -1));
    }).observe(trigger);
  }

  // Подсветка текущего раздела в подменю
  const links = document.querySelectorAll<HTMLAnchorElement>('.subnav__link');
  const targets = Array.from(links)
    .map((a) => document.querySelector<HTMLElement>(a.hash))
    .filter((el): el is HTMLElement => !!el);
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.classList.toggle('is-active', a.hash === `#${entry.target.id}`));
      }
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );
  targets.forEach((el) => spy.observe(el));
</script>
