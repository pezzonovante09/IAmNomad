</style>

<script>
  const expandBtn = document.querySelector<HTMLButtonElement>('[data-expand-all]');
  const dayEls = document.querySelectorAll<HTMLDetailsElement>('.day');
  expandBtn?.addEventListener('click', () => {
    const open = Array.from(dayEls).some((d) => !d.open);
    dayEls.forEach((d) => (d.open = open));
    expandBtn.textContent = (open ? expandBtn.dataset.collapse : expandBtn.dataset.expand) ?? '';
  });

  const bar = document.querySelector<HTMLElement>('[data-bookbar]');
  const trigger = document.querySelector('[data-bookbar-trigger]');
  if (bar && trigger) {
    document.body.classList.add('has-bookbar');
    new IntersectionObserver(([entry]) => {
      const visible = !entry.isIntersecting;
      bar.classList.toggle('is-visible', visible);
      bar.setAttribute('aria-hidden', String(!visible));
      bar.querySelectorAll('a').forEach((a) => (a.tabIndex = visible ? 0 : -1));
    }).observe(trigger);
  }

  const links = document.querySelectorAll<HTMLAnchorElement>('.subnav__link');
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) links.forEach((a) => a.classList.toggle('is-active', a.hash === `#${entry.target.id}`));
      }
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );
  links.forEach((a) => {
    const el = document.querySelector(a.hash);
    if (el) spy.observe(el);
  });
</script>
