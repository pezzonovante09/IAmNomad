---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
import { localize, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} page="404" path="/404/" title={t('notFound.title')} description={t('notFound.text')}>
  <section class="nf">
    <p class="label">(404)</p>
    <h1 class="h1">{t('notFound.title')}</h1>
    <p class="nf__text">{t('notFound.text')}</p>
    <a href={localize('/', lang)} class="btn btn--accent">{t('notFound.cta')} <span aria-hidden="true">→</span></a>
    <div class="nf__disc" aria-hidden="true"><Ornament variant="tunduk" stroke="#C5A059" /></div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 20px;
    min-height: calc(100svh - var(--header-h) - 120px);
    padding: 64px var(--gutter);
    overflow: hidden;
  }

  .nf__text {
    max-width: 44ch;
    font-size: 18px;
  }

  .nf__disc {
    position: absolute;
    right: -80px;
    bottom: -80px;
    width: 420px;
    opacity: 0.6;
  }

  .nf__disc :global(svg) {
    width: 100%;
    height: auto;
    animation: spin 60s linear infinite;
  }
</style>
