---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Faq from '../components/Faq.astro';
import PageHero from '../components/PageHero.astro';
import { contacts } from '../data/site';
import { localize, useTranslations, type Lang } from '../i18n/utils';
import { routes } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = [1, 2, 3, 4, 5, 6, 7].map((n) => ({ q: t(`faq.q${n}`), a: t(`faq.a${n}`) }));
---

<BaseLayout lang={lang} page="faq" path={routes.faq}>
  <PageHero kicker="(01) FAQ" meta={`${String(items.length).padStart(2, '0')} ?`} title={t('faq.title')} subtitle={t('faq.subtitle')} />
  <Faq items={items} openFirst />
  <CtaBanner
    kicker="(02)"
    title={t('faq.cta.title')}
    text={t('faq.cta.text')}
    primary={{ href: contacts.whatsapp, label: t('tour.booking.whatsapp'), external: true }}
    secondary={{ href: localize(routes.contact, lang), label: t('nav.contact') }}
  />
</BaseLayout>
