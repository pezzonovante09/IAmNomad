---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCards from '../components/ContactCards.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { micePhoto } from '../data/content';
import { useTranslations, type Lang } from '../i18n/utils';
import { routes } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pad = (n: number) => String(n).padStart(2, '0');

const services = [
  { key: 'conferences', img: '/uploads/mice-group.jpg', alt: 'Group of guests at a nomad show on Issyk-Kul' },
  { key: 'incentive', img: '/uploads/tour-classic-cover.jpg', alt: 'Nomad show by the yurts on Issyk-Kul' },
  { key: 'teambuilding', img: '/uploads/gallery-04.jpg', alt: 'Horse rider performing a trick' },
  { key: 'cultural', img: '/uploads/about-eagle.jpg', alt: 'Golden eagle and its handler' },
] as const;

const why = [
  { n: 1, icon: 'mountain' },
  { n: 2, icon: 'star' },
  { n: 3, icon: 'pin' },
  { n: 4, icon: 'sun' },
  { n: 5, icon: 'users' },
] as const;

const days = [
  { n: 1, img: '/uploads/gallery-12.jpg', alt: 'Singers in white by the yurts' },
  { n: 2, img: '/uploads/mice-group.jpg', alt: 'Group of guests' },
  { n: 3, img: '/uploads/gallery-04.jpg', alt: 'Horse rider performing a trick' },
  { n: 4, img: '/uploads/gallery-03.jpg', alt: 'Children dancing a national dance' },
  { n: 5, img: '/uploads/gallery-10.jpg', alt: 'Eagle hunters on the beach' },
] as const;

const advantages = [
  { n: 1, icon: 'compass' },
  { n: 2, icon: 'sparkles' },
  { n: 3, icon: 'check' },
  { n: 4, icon: 'route' },
  { n: 5, icon: 'star' },
  { n: 6, icon: 'users' },
] as const;
---

<BaseLayout lang={lang} page="mice" path={routes.mice}>
  <div class="mice">
    <PageHero kicker={t('mice.kicker')} meta="B2B" title={t('mice.title')} subtitle={t('mice.subtitle')} photo={micePhoto}>
      <div class="mice__ctas" data-reveal>
        <a href="#contact-form" class="btn btn--accent">{t('mice.cta.plan')} <Icon name="arrow-right" /></a>
        <a href="#services" class="btn btn--outline">{t('mice.cta.explore')} <Icon name="arrow-down" /></a>
      </div>
    </PageHero>

    <section class="lead-block">
      <p class="lead-block__text" data-reveal>{t('mice.description')}</p>
    </section>

    <section id="services" class="anchor">
      <SectionHeader title={t('mice.services.title')} />
      <ul class="mgrid mgrid--4">
        {
          services.map((s, i) => (
            <li class="card" data-reveal style={`--i:${i}`}>
              <img class="card__img" src={s.img} alt={s.alt} width="800" height="534" loading="lazy" decoding="async" />
              <div class="card__body">
                <h3 class="card__title">{t(`mice.services.${s.key}`)}</h3>
                <p class="muted">{t(`mice.services.${s.key}Text`)}</p>
                <a href="#contact-form" class="link-more label">{t('mice.services.learnMore')} <Icon name="arrow-right" size={16} /></a>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <SectionHeader kicker={t('mice.why.kicker')} title={t('mice.why.title')} />
      <ul class="mgrid mgrid--5">
        {
          why.map((w, i) => (
            <li class="cell" data-reveal style={`--i:${i}`}>
              <Icon name={w.icon} size={28} />
              <h3 class="cell__title">{t(`mice.why.${w.n}`)}</h3>
              <p class="muted">{t(`mice.why.${w.n}Text`)}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <SectionHeader kicker={t('mice.approach.kicker')} title={t('mice.approach.title')} />
      <ol class="mgrid mgrid--4">
        {
          [1, 2, 3, 4].map((n, i) => (
            <li class="cell" data-reveal style={`--i:${i}`}>
              <span class="cell__num label num">{pad(n)}</span>
              <h3 class="cell__title">{t(`mice.approach.${n}`)}</h3>
              <p class="muted">{t(`mice.approach.${n}Text`)}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section>
      <SectionHeader kicker={t('mice.programme.kicker')} title={t('mice.programme.title')} subtitle={t('mice.programme.intro')} />
      <ol class="mgrid mgrid--5">
        {
          days.map((d, i) => (
            <li class="card card--day" data-reveal style={`--i:${i}`}>
              <img class="card__img" src={d.img} alt={d.alt} width="800" height="534" loading="lazy" decoding="async" />
              <div class="card__body">
                <span class="label num">{t('mice.programme.day')} {d.n}</span>
                <h3 class="card__title">{t(`mice.programme.${d.n}`)}</h3>
                <p class="muted">{t(`mice.programme.${d.n}Text`)}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="note muted" data-reveal>{t('mice.programme.note')}</p>
    </section>

    <section>
      <SectionHeader kicker={t('mice.advantages.kicker')} title={t('mice.advantages.title')} />
      <ul class="mgrid mgrid--3">
        {
          advantages.map((a, i) => (
            <li class="cell" data-reveal style={`--i:${i}`}>
              <Icon name={a.icon} size={28} />
              <h3 class="cell__title">{t(`mice.advantages.${a.n}`)}</h3>
              <p class="muted">{t(`mice.advantages.${a.n}Text`)}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="form-block anchor" id="contact-form">
      <SectionHeader title={t('mice.form.title')} subtitle={t('mice.form.subtitle')} />
      <div class="form-block__grid">
        <div class="form-block__side">
          <p class="label">{t('home.form.aside')}</p>
          <ContactCards lang={lang} layout="list" />
        </div>
        <div class="form-block__form" data-reveal>
          <LeadForm lang={lang} variant="corporate" id="corp" />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Длинный H1 страницы (нужен для SEO) делаем компактнее, чем у коротких заголовков */
  .mice :global(.ph__title) {
    font-size: clamp(32px, 5.6vw, 96px);
    line-height: 1;
  }

  .mice__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding: 0 var(--gutter) 32px;
  }

  .anchor {
    scroll-margin-top: var(--header-h);
  }

  .lead-block {
    padding: 48px var(--gutter);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .lead-block__text {
    max-width: 1100px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(22px, 2.6vw, 40px);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  /* Сетка с тонкими линиями между ячейками (как на остальных страницах) */
  .mgrid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1px;
    list-style: none;
    background: var(--line);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .mgrid--3 {
    --cols: 3;
  }
  .mgrid--4 {
    --cols: 4;
  }
  .mgrid--5 {
    --cols: 5;
  }

  .mgrid > li {
    background: var(--bg);
    min-width: 0;
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 240px;
    padding: 28px var(--gutter);
    transition:
      background-color 0.5s,
      color 0.5s;
  }

  .cell:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .cell:hover .muted {
    color: inherit;
  }

  .cell__num {
    color: var(--ink-soft);
  }

  .cell:hover .cell__num {
    color: inherit;
  }

  .cell__title,
  .card__title {
    font-size: clamp(20px, 1.8vw, 28px);
    font-weight: 600;
    line-height: 1.15;
  }

  .cell__title {
    margin-top: auto;
  }

  .card {
    display: flex;
    flex-direction: column;
  }

  .card__img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: 20px var(--gutter) 24px;
  }

  .link-more {
    margin-top: auto;
    padding-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
  }

  .link-more:hover {
    text-decoration: underline;
  }

  .note {
    max-width: 900px;
    padding: 20px var(--gutter) 40px;
    font-size: 14px;
  }

  .form-block {
    border-top: 1px solid var(--line);
  }

  .form-block__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    border-top: 1px solid var(--line);
  }

  .form-block__side {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 32px var(--gutter);
    border-right: 1px solid var(--line);
  }

  .form-block__form {
    padding: 32px var(--gutter) 48px;
    background: var(--surface);
  }

  @media (max-width: 1100px) {
    .mgrid--4,
    .mgrid--5 {
      --cols: 2;
    }

    .mgrid--3 {
      --cols: 2;
    }

    /* нечётный последний элемент занимает всю строку — без пустой ячейки */
    .mgrid > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 900px) {
    .form-block__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .form-block__side {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 600px) {
    .mgrid--3,
    .mgrid--4,
    .mgrid--5 {
      --cols: 1;
    }

    .cell {
      min-height: 0;
    }

    .mice__ctas .btn {
      flex: 1 1 100%;
    }
  }
</style>
