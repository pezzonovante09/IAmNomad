---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import PageHero from '../components/PageHero.astro';
import TourIndex from '../components/TourIndex.astro';
import { whatsappLink } from '../data/site';
import { customTourEnabled, hasPage, tourCategories, tours } from '../data/tours';
import { localize, useTranslations, type Lang } from '../i18n/utils';
import { routes } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout lang={lang} page="tours" path={routes.tours}>
  <PageHero
    kicker={t('home.index.kicker')}
    meta={`${pad(tours.filter(hasPage).length)} ${t('home.index.count')}`}
    title={t('tours.title')}
    subtitle={t('tours.subtitle')}
  />

  <h2 class="sr-only">{t('tours.title')}</h2>
  <div class="filters" role="group" aria-label={t('tours.title')} data-filters>
    {
      tourCategories.map((cat, i) => (
        <button type="button" class="filters__btn" data-filter={cat} aria-pressed={i === 0 ? 'true' : 'false'}>
          {t(`tours.tab.${cat}`)}
        </button>
      ))
    }
  </div>

  <TourIndex lang={lang} tours={tours} priority />

  {
    customTourEnabled && (
      <CtaBanner
        kicker={t('home.builder.kicker')}
        title={t('tour.custom.intro.title')}
        text={t('tour.custom.intro.p3')}
        primary={{ href: localize(routes.tour('custom'), lang), label: t('tour.custom.cta.button') }}
        secondary={{ href: whatsappLink(t('whatsapp.text')), label: t('tour.booking.whatsapp'), external: true, icon: 'whatsapp' }}
      />
    )
  }
</BaseLayout>

<style>
  .filters {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  /* На телефоне кнопки переносятся: иначе видно только первые три из девяти. */
  @media (max-width: 700px) {
    .filters {
      flex-wrap: wrap;
      overflow: visible;
      border-bottom: 1px solid var(--line);
    }

    .filters__btn {
      flex: 1 1 auto;
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
    }
  }

  .filters__btn {
    flex: 1 0 auto;
    padding: 16px 24px;
    border: 0;
    border-right: 1px solid var(--line);
    background: var(--bg);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition:
      background-color 0.5s,
      color 0.5s;
  }

  .filters__btn:last-child {
    border-right: 0;
  }

  .filters__btn:hover {
    background: var(--surface);
  }

  .filters__btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('[data-tour-index] [data-row]');

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let first: HTMLElement | null = null;
      rows.forEach((row) => {
        const show = filter === 'all' || row.dataset.category === filter;
        row.classList.toggle('is-hidden', !show);
        row.classList.add('is-visible');
        if (show && !first) first = row;
      });
      // Раскрываем первую видимую строку.
      if (first && !(first as HTMLElement).classList.contains('is-open')) {
        (first as HTMLElement).querySelector<HTMLButtonElement>('[data-row-toggle]')?.click();
      }
    }),
  );
</script>
