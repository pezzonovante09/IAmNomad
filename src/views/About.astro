---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import PageHero from '../components/PageHero.astro';
import { aboutPhoto } from '../data/content';
import { contacts } from '../data/site';
import { localize, useTranslations, type Lang } from '../i18n/utils';
import { routes } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} page="about" path={routes.about}>
  <PageHero kicker="I AM NOMAD" title={t('about.title')} subtitle={t('about.subtitle')} photo={aboutPhoto}>
    <div slot="overlay" class="story">
      <p class="story__lead">{t('about.history.p1')}</p>
      <p>{t('about.history.p2')}</p>
      <p>{t('about.history.p3')}</p>
    </div>
  </PageHero>

  <CtaBanner
    kicker={`${t('about.mission.title')}`}
    title={t('about.cta.title')}
    text={t('about.mission.text')}
    primary={{ href: localize(routes.tours, lang), label: t('home.hero.cta') }}
    secondary={{ href: contacts.whatsapp, label: t('tour.booking.whatsapp'), external: true, icon: 'whatsapp' }}
  />
</BaseLayout>

<style>
  .story {
    display: grid;
    gap: 16px;
  }

  .story__lead {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 2vw, 30px);
    line-height: 1.3;
  }
</style>
