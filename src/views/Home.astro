---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCards from '../components/ContactCards.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import Ornament from '../components/Ornament.astro';
import ReviewCard from '../components/ReviewCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TourIndex from '../components/TourIndex.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { heroRegions, instagramPhotos, reviewAvatars } from '../data/content';
import { contacts, videos } from '../data/site';
import { tours } from '../data/tours';
import { localize, useTranslations, type Lang } from '../i18n/utils';
import { srcset, unsplash } from '../lib/img';
import { routes } from '../lib/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localize(p, lang);
const pad = (n: number) => String(n).padStart(2, '0');

const regions = heroRegions.map((r, i) => ({
  ...r,
  num: pad(i + 1),
  name: t(`region.${r.key}.name`),
  oblast: t(`region.${r.key}.oblast`),
  line: t(`region.${r.key}.line`),
  altLabel: `${r.alt} ${t('unit.m')}`,
}));

const features = ['feature1', 'feature2', 'feature3', 'feature4'];
---

<BaseLayout lang={lang} page="home" path="/" image={unsplash(regions[0].photo, 1200, 630)}>
  <!-- (01) Манифест -->
  <section class="hero" id="top">
    <div class="hero__meta label" data-reveal="fade" data-delay="150">
      <span>{t('home.hero.kicker')}</span>
      <span>{t('home.hero.regionsLine')}</span>
      <span>{t('home.hero.season')}</span>
    </div>
    <h1 class="hero__title">
      <span class="hero__row">
        <span data-reveal="up" data-delay="250">{t('home.hero.line1')}</span>
        <span class="hero__text" data-reveal="fade" data-delay="850">{t('home.hero.text')}</span>
      </span>
      <span class="hero__accent" data-reveal="up" data-delay="420">{t('home.hero.line2')}</span>
    </h1>

    <div class="hero__stage" data-slideshow>
      <div class="hero__screen" data-reveal="curtain" data-delay="550">
        {
          regions.map((r, i) => (
            <img
              class:list={['hero__slide', { 'is-active': i === 0 }]}
              data-slide
              src={unsplash(r.photo, 1600, 1000)}
              srcset={srcset(r.photo, [800, 1200, 1600, 2200], 0.62)}
              sizes="(max-width: 900px) 100vw, 66vw"
              alt={r.name}
              width="1600"
              height="1000"
              fetchpriority={i === 0 ? 'high' : undefined}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))
        }
        <div class="hero__shade" aria-hidden="true"></div>
        <div class="hero__screen-top label" data-reveal="fade" data-delay="1300">
          <span>
            {t('home.hero.nowShowing')} — <span data-cur-num>{regions[0].num}</span> / {pad(regions.length)}
          </span>
          <span class="num" data-cur-coords>{regions[0].coords}</span>
        </div>
        <div class="hero__screen-bottom" data-reveal="up" data-delay="1400">
          <div class="hero__bars" aria-hidden="true">
            {regions.map((_, i) => <span class:list={{ 'is-active': i === 0 }} data-bar />)}
          </div>
          <p class="hero__name" data-cur-name>{regions[0].name}</p>
          <p class="hero__line" data-cur-line>{regions[0].line}</p>
        </div>
      </div>

      <div class="hero__list">
        <div class="hero__list-head label" data-reveal="fade" data-delay="750">
          <span>{t('home.hero.regionsTitle')}</span>
          <span class="hero__hint">{t('home.hero.hoverHint')}</span>
        </div>
        {
          regions.map((r, i) => (
            <button
              type="button"
              class:list={['hero__region', { 'is-active': i === 0 }]}
              data-region={i}
              data-name={r.name}
              data-line={r.line}
              data-coords={r.coords}
              data-num={r.num}
              data-reveal="up"
              data-delay={850 + i * 120}
            >
              <span class="hero__region-meta label num">
                <span>
                  {r.num} · {r.oblast}
                </span>
                <span>{r.altLabel}</span>
              </span>
              <span class="hero__region-name">{r.name}</span>
            </button>
          ))
        }
        <a href="#index" class="hero__browse label" data-reveal="fade" data-delay="1300">
          <span>{t('home.hero.browse')}</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <div class="band" data-reveal="fade"><div class="ornament-band"></div></div>

  <!-- (02) Каталог -->
  <section id="index" class="index">
    <SectionHeader kicker={t('home.index.kicker')} title={t('home.tours.title')} meta={`${pad(tours.length)} ${t('home.index.count')} · 2026`} />
    <TourIndex lang={lang} tours={tours} />
  </section>

  <!-- (03) Подход -->
  <section class="why">
    <SectionHeader kicker={t('home.why.kicker')} title={t('home.why.title')} subtitle={t('home.why.subtitle')} />
    <ol class="why__grid">
      {
        features.map((f, i) => (
          <li class="why__cell" data-reveal style={`--i:${i}`}>
            <span class="label num">({pad(i + 1)})</span>
            <h3 class="why__title">{t(`home.why.${f}.title`)}</h3>
            <p class="muted">{t(`home.why.${f}.text`)}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- (04) Свой маршрут -->
  <section class="builder">
    <div class="builder__text">
      <p class="label" data-reveal="fade">{t('home.builder.kicker')}</p>
      <h2 class="h2" data-reveal>{t('tour.custom.cta.title')}</h2>
      <p class="builder__lead" data-reveal>{t('tour.custom.intro.p2')}</p>
      <div class="builder__actions" data-reveal>
        <a href={L(routes.tour('custom'))} class="btn btn--light">
          {t('tour.custom.cta.button')}
          <span aria-hidden="true">→</span>
        </a>
        <a href={contacts.whatsapp} class="btn btn--glass" target="_blank" rel="noopener">
          {t('tour.booking.whatsapp')}
          <Icon name="whatsapp" />
        </a>
      </div>
    </div>
    <div class="builder__disc" aria-hidden="true">
      <Ornament variant="tunduk" stroke="#C5A059" />
    </div>
  </section>

  {
    videos.home && (
      <section class="video-block">
        <SectionHeader title={t('home.video.title')} subtitle={t('home.video.subtitle')} />
        <div class="container">
          <VideoEmbed src={videos.home} title={t('home.video.title')} />
        </div>
      </section>
    )
  }

  <!-- (05) Отзывы -->
  <section class="reviews">
    <SectionHeader kicker={t('home.reviews.kicker')} title={t('home.reviews.title')} subtitle={t('home.reviews.subtitle')}>
      <a href={L(routes.reviews)} class="link-arrow">{t('btn.viewAll')} <Icon name="arrow-right" /></a>
    </SectionHeader>
    <div class="reviews__grid">
      {
        [1, 2, 3].map((n, i) => (
          <ReviewCard name={t(`home.reviews.review${n}.name`)} text={t(`home.reviews.review${n}.text`)} avatar={reviewAvatars[i]} index={i} />
        ))
      }
    </div>
  </section>

  <!-- (06) Instagram -->
  <section class="insta">
    <SectionHeader kicker={t('home.instagram.kicker')} title={contacts.instagramHandle} subtitle={t('home.instagram.subtitle').replace(/^@\S+\s—\s/, '')}>
      <a href={contacts.instagram} class="link-arrow" target="_blank" rel="noopener">Instagram <Icon name="arrow-right" /></a>
    </SectionHeader>
    <div class="insta__grid">
      {
        instagramPhotos.map((p, i) => (
          <a href={contacts.instagram} class="insta__item" target="_blank" rel="noopener" data-reveal="fade" style={`--i:${i}`}>
            <img src={unsplash(p.id, 480, 480)} srcset={srcset(p.id, [240, 480, 720], 1)} sizes="(max-width: 700px) 33vw, 17vw" alt={p.alt} width="480" height="480" loading="lazy" />
          </a>
        ))
      }
    </div>
  </section>

  <!-- (07) Заявка -->
  <section class="request" id="contact-form">
    <SectionHeader kicker={t('home.form.kicker')} title={t('home.form.title')} subtitle={t('home.form.subtitle')} />
    <div class="request__grid">
      <div class="request__side">
        <p class="label">{t('home.form.aside')}</p>
        <ContactCards lang={lang} layout="list" />
      </div>
      <div class="request__form" data-reveal>
        <LeadForm lang={lang} variant="lead" id="lead" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- (01) Герой ---------- */
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-h));
    border-bottom: 1px solid var(--line);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding: 20px var(--gutter) 0;
  }

  .hero__title {
    padding: 8px var(--gutter) 28px;
    font-size: clamp(44px, min(12.4vw, 13vh), 250px);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .hero__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 32px;
  }

  .hero__text {
    max-width: 340px;
    padding-bottom: 0.9em;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    letter-spacing: 0;
    text-transform: none;
  }

  .hero__accent {
    display: block;
    color: var(--accent);
  }

  .hero__stage {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
  }

  .hero__screen {
    position: relative;
    flex: 3 1 560px;
    min-height: 300px;
    overflow: hidden;
    background: #111;
    color: #f5f5f3;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 0.9s ease,
      transform 2.4s var(--ease);
  }

  .hero__slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background: var(--overlay);
    pointer-events: none;
  }

  .hero__screen-top {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
  }

  .hero__screen-bottom {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
  }

  .hero__bars {
    display: flex;
    gap: 6px;
    max-width: 240px;
    margin-bottom: 18px;
  }

  .hero__bars span {
    flex: 1;
    height: 2px;
    background: rgb(245 245 243 / 0.35);
    transition: background-color 0.5s;
  }

  .hero__bars span.is-active {
    background: var(--gold);
  }

  .hero__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, min(6.4vw, 10vh), 108px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero__line {
    max-width: 460px;
    margin-top: 8px;
    font-size: 15px;
  }

  .hero__list {
    display: flex;
    flex: 1 1 320px;
    flex-direction: column;
    border-left: 1px solid var(--line);
    background: var(--surface);
  }

  .hero__list-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 24px;
    border-bottom: 1px solid var(--line);
  }

  .hero__region {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 24px;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    text-align: left;
    transition:
      background-color 0.5s,
      color 0.5s;
  }

  .hero__region.is-active {
    background: var(--accent);
    color: var(--on-accent);
  }

  .hero__region-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .hero__region-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(26px, min(3vw, 4.4vh), 46px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .hero__browse {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 24px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-decoration: none;
    transition: background-color 0.5s;
  }

  .hero__browse:hover {
    background: var(--ink);
    color: var(--bg);
  }

  @media (max-width: 700px) {
    .hero__meta span:nth-child(2),
    .hero__screen-top .num {
      display: none;
    }

    .hero__title {
      display: flex;
      flex-direction: column;
    }

    .hero__row {
      display: contents;
    }

    .hero__text {
      order: 3;
      padding: 16px 0 0;
    }
  }

  @media (hover: none) {
    .hero__hint {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero__list {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .hero__region {
      flex: 0 0 auto;
    }
  }

  /* ---------- Орнамент ---------- */
  .band {
    padding: 28px var(--gutter);
    border-bottom: 1px solid var(--line);
  }

  .index {
    scroll-margin-top: var(--header-h);
  }

  /* ---------- (03) Подход ---------- */
  .why {
    border-top: 1px solid var(--line);
  }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .why__cell {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 260px;
    padding: 28px var(--gutter);
    border-right: 1px solid var(--line);
  }

  .why__cell:last-child {
    border-right: 0;
  }

  .why__title {
    margin-top: auto;
    font-size: clamp(22px, 2vw, 32px);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .why__grid {
      grid-template-columns: 1fr 1fr;
    }

    .why__cell:nth-child(2) {
      border-right: 0;
    }

    .why__cell:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 520px) {
    .why__grid {
      grid-template-columns: 1fr;
    }

    .why__cell {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .why__cell:last-child {
      border-bottom: 0;
    }
  }

  /* ---------- (04) Свой маршрут ---------- */
  .builder {
    position: relative;
    display: flex;
    align-items: center;
    gap: 32px;
    overflow: hidden;
    padding: clamp(56px, 8vw, 120px) var(--gutter);
    border-top: 1px solid var(--line);
    background: #0d3e26;
    color: #f5f5f3;
  }

  .builder__text {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 20px;
    max-width: 900px;
  }

  .builder__lead {
    max-width: 58ch;
    font-size: 16px;
    color: rgb(245 245 243 / 0.85);
  }

  .builder__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .builder__disc {
    position: absolute;
    right: clamp(-160px, -8vw, -40px);
    top: 50%;
    width: clamp(280px, 38vw, 560px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0.55;
  }

  .builder__disc :global(svg) {
    width: 100%;
    height: 100%;
    animation: spin 60s linear infinite;
  }

  /* ---------- (05) Отзывы ---------- */
  .reviews {
    border-top: 1px solid var(--line);
  }

  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .reviews__grid > :global(*) {
    border-right: 1px solid var(--line);
  }

  .reviews__grid > :global(*:last-child) {
    border-right: 0;
  }

  @media (max-width: 900px) {
    .reviews__grid {
      grid-template-columns: 1fr;
    }

    .reviews__grid > :global(*) {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .reviews__grid > :global(*:last-child) {
      border-bottom: 0;
    }
  }

  /* ---------- (06) Instagram ---------- */
  .insta {
    border-top: 1px solid var(--line);
  }

  .insta__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-top: 1px solid var(--line);
  }

  .insta__item {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-right: 1px solid var(--line);
  }

  .insta__item:last-child {
    border-right: 0;
  }

  .insta__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35);
    transition:
      transform 1.4s var(--ease),
      filter 0.6s;
  }

  .insta__item:hover img {
    transform: scale(1.06);
    filter: none;
  }

  @media (max-width: 700px) {
    .insta__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .insta__item:nth-child(3) {
      border-right: 0;
    }

    .insta__item:nth-child(-n + 3) {
      border-bottom: 1px solid var(--line);
    }
  }

  /* ---------- (07) Заявка ---------- */
  .request {
    border-top: 1px solid var(--line);
    scroll-margin-top: var(--header-h);
  }

  .request__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    border-top: 1px solid var(--line);
  }

  .request__side {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 32px var(--gutter);
    border-right: 1px solid var(--line);
  }

  .request__form {
    padding: 32px var(--gutter) 48px;
    background: var(--surface);
  }

  @media (max-width: 900px) {
    .request__grid {
      grid-template-columns: 1fr;
    }

    .request__side {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>

<script>
  // Слайдшоу регионов: автосмена каждые 5 с, пауза при наведении, выбор наведением/кликом.
  const stage = document.querySelector<HTMLElement>('[data-slideshow]');
  if (stage) {
    const slides = stage.querySelectorAll<HTMLElement>('[data-slide]');
    const bars = stage.querySelectorAll<HTMLElement>('[data-bar]');
    const items = stage.querySelectorAll<HTMLButtonElement>('[data-region]');
    const num = stage.querySelector('[data-cur-num]')!;
    const coords = stage.querySelector('[data-cur-coords]')!;
    const name = stage.querySelector('[data-cur-name]')!;
    const line = stage.querySelector('[data-cur-line]')!;
    let current = 0;
    let paused = false;

    function show(i: number) {
      current = i;
      const item = items[i];
      slides.forEach((s, j) => s.classList.toggle('is-active', j === i));
      bars.forEach((b, j) => b.classList.toggle('is-active', j === i));
      items.forEach((it, j) => it.classList.toggle('is-active', j === i));
      num.textContent = item.dataset.num ?? '';
      coords.textContent = item.dataset.coords ?? '';
      name.textContent = item.dataset.name ?? '';
      line.textContent = item.dataset.line ?? '';
    }

    items.forEach((item, i) => {
      item.addEventListener('mouseenter', () => i !== current && show(i));
      item.addEventListener('click', () => show(i));
    });
    const list = stage.querySelector('.hero__list');
    list?.addEventListener('mouseenter', () => (paused = true));
    list?.addEventListener('mouseleave', () => (paused = false));

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => {
        if (!paused && !document.hidden) show((current + 1) % items.length);
      }, 5000);
    }
  }
</script>
