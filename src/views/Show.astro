</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Лёгкий параллакс на первом экране
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const media = document.querySelector<HTMLElement>('[data-parallax]');
  if (hero && media && !reduce) {
    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = Math.min(scrollY, hero.offsetHeight);
          media.style.transform = `translate3d(0, ${y * 0.25}px, 0) scale(${1 + y / hero.offsetHeight / 12})`;
          ticking = false;
        });
      },
      { passive: true },
    );
  }

  // Счётчики «Шоу в цифрах»
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.count);
    if (reduce) return;
    const start = performance.now();
    const dur = 1600;
    const step = (now: number) => {
      const p = Math.min(1, (now - start) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(step);
    };
    el.textContent = '0';
    requestAnimationFrame(step);
  };
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          animate(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.4 },
  );
  counters.forEach((c) => io.observe(c));

  // Слайдер отзывов
  const track = document.querySelector<HTMLElement>('[data-rev-track]');
  const move = (dir: number) => {
    if (!track) return;
    const card = track.querySelector<HTMLElement>('li');
    track.scrollBy({ left: dir * (card?.offsetWidth ?? 320), behavior: 'smooth' });
  };
  document.querySelector('[data-rev-prev]')?.addEventListener('click', () => move(-1));
  document.querySelector('[data-rev-next]')?.addEventListener('click', () => move(1));

  // Фильтр галереи (если есть видео)
  const galBtns = document.querySelectorAll<HTMLButtonElement>('[data-gal-filter]');
  galBtns.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.galFilter;
      galBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      document.querySelectorAll<HTMLElement>('.gal__item').forEach((it) => {
        it.classList.toggle('is-hidden', f !== 'all' && it.dataset.kind !== f);
        it.classList.add('is-visible');
      });
    }),
  );

  // Липкая кнопка брони на телефоне: видна после первого экрана и до формы
  const mbook = document.querySelector<HTMLElement>('[data-mbook]');
  const booking = document.getElementById('show-booking');
  if (mbook && hero && booking) {
    let pastHero = false;
    let atForm = false;
    const sync = () => {
      const on = pastHero && !atForm;
      mbook.classList.toggle('is-visible', on);
      mbook.setAttribute('aria-hidden', String(!on));
      mbook.tabIndex = on ? 0 : -1;
      document.body.classList.toggle('has-bookbar', on);
    };
    new IntersectionObserver(([e]) => ((pastHero = !e.isIntersecting), sync())).observe(hero);
    new IntersectionObserver(([e]) => ((atForm = e.isIntersecting), sync())).observe(booking);
  }
</script>
