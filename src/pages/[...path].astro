---
// Единый маршрутизатор: каждая страница строится для ru (без префикса) и en (/en/...).
import About from '../views/About.astro';
import Article from '../views/Article.astro';
import Blog from '../views/Blog.astro';
import Contact from '../views/Contact.astro';
import CustomTour from '../views/CustomTour.astro';
import Faq from '../views/Faq.astro';
import Gallery from '../views/Gallery.astro';
import Home from '../views/Home.astro';
import Mice from '../views/Mice.astro';
import Reviews from '../views/Reviews.astro';
import Show from '../views/Show.astro';
import Tour from '../views/Tour.astro';
import Tours from '../views/Tours.astro';
import { tours, type TourSlug } from '../data/tours';
import { languages, defaultLang, type Lang } from '../i18n/utils';
import { routes } from '../lib/routes';

type View = 'home' | 'about' | 'tours' | 'tour' | 'custom' | 'show' | 'mice' | 'blog' | 'article' | 'reviews' | 'gallery' | 'faq' | 'contact';

export function getStaticPaths() {
  const pages: { path: string; view: View; slug?: TourSlug }[] = [
    { path: routes.home, view: 'home' },
    { path: routes.about, view: 'about' },
    { path: routes.tours, view: 'tours' },
    ...tours.map((tour) => ({
      path: routes.tour(tour.slug),
      view: (tour.slug === 'custom' ? 'custom' : 'tour') as View,
      slug: tour.slug,
    })),
    { path: routes.show, view: 'show' },
    { path: routes.mice, view: 'mice' },
    { path: routes.blog, view: 'blog' },
    { path: routes.article, view: 'article' },
    { path: routes.reviews, view: 'reviews' },
    { path: routes.gallery, view: 'gallery' },
    { path: routes.faq, view: 'faq' },
    { path: routes.contact, view: 'contact' },
  ];

  return (Object.keys(languages) as Lang[]).flatMap((lang) =>
    pages.map((page) => {
      const trimmed = page.path.replace(/^\/|\/$/g, '');
      const full = lang === defaultLang ? trimmed : [lang, trimmed].filter(Boolean).join('/');
      return { params: { path: full || undefined }, props: { lang, view: page.view, slug: page.slug } };
    }),
  );
}

const { lang, view, slug } = Astro.props as { lang: Lang; view: View; slug?: TourSlug };
const tour = slug ? tours.find((x) => x.slug === slug) : undefined;
---

{view === 'home' && <Home lang={lang} />}
{view === 'about' && <About lang={lang} />}
{view === 'tours' && <Tours lang={lang} />}
{view === 'tour' && tour && <Tour lang={lang} tour={tour} />}
{view === 'custom' && <CustomTour lang={lang} />}
{view === 'show' && <Show lang={lang} />}
{view === 'mice' && <Mice lang={lang} />}
{view === 'blog' && <Blog lang={lang} />}
{view === 'article' && <Article lang={lang} />}
{view === 'reviews' && <Reviews lang={lang} />}
{view === 'gallery' && <Gallery lang={lang} />}
{view === 'faq' && <Faq lang={lang} />}
{view === 'contact' && <Contact lang={lang} />}
