{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/tours.html",
      "destination": "/tours/",
      "permanent": true
    },
    {
      "source": "/tour-classic.html",
      "destination": "/tours/classic/",
      "permanent": true
    },
    {
      "source": "/tour-single.html",
      "destination": "/tours/classic/",
      "permanent": true
    },
    {
      "source": "/tour-adventure.html",
      "destination": "/tours/adventure/",
      "permanent": true
    },
    {
      "source": "/tour-winter.html",
      "destination": "/tours/winter/",
      "permanent": true
    },
    {
      "source": "/tour-custom.html",
      "destination": "/tours/",
      "permanent": false
    },
    {
      "source": "/tours/custom/",
      "destination": "/tours/",
      "permanent": false
    },
    {
      "source": "/en/tours/custom/",
      "destination": "/en/tours/",
      "permanent": false
    },
    {
      "source": "/mice.html",
      "destination": "/mice/",
      "permanent": true
    },
    {
      "source": "/blog/:path*/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/blog/:path*/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog-single.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/reviews.html",
      "destination": "/reviews/",
      "permanent": true
    },
    {
      "source": "/gallery.html",
      "destination": "/gallery/",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/faq/",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
