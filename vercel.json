{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "i-am-nomad.vercel.app"
        }
      ],
      "destination": "https://www.iamnomadkg.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/tours.html",
      "destination": "/tours/",
      "permanent": true
    },
    {
      "source": "/tour-classic.html",
      "destination": "/tours/classic/",
      "permanent": true
    },
    {
      "source": "/tour-single.html",
      "destination": "/tours/classic/",
      "permanent": true
    },
    {
      "source": "/tour-adventure.html",
      "destination": "/tours/adventure/",
      "permanent": true
    },
    {
      "source": "/tour-winter.html",
      "destination": "/tours/winter/",
      "permanent": true
    },
    {
      "source": "/tour-custom.html",
      "destination": "/tours/",
      "permanent": false
    },
    {
      "source": "/tours/custom/",
      "destination": "/tours/",
      "permanent": false
    },
    {
      "source": "/en/tours/custom/",
      "destination": "/en/tours/",
      "permanent": false
    },
    {
      "source": "/mice.html",
      "destination": "/mice/",
      "permanent": true
    },
    {
      "source": "/blog/:path*/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/blog/:path*/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/blog.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog-single.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/reviews.html",
      "destination": "/reviews/",
      "permanent": true
    },
    {
      "source": "/gallery.html",
      "destination": "/gallery/",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/faq/",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/((?!admin/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: https://lh3.googleusercontent.com https://images.unsplash.com; font-src 'self'; media-src 'self'; connect-src 'self' https://yqamuqihlrccpbcgzqsc.supabase.co https://api.web3forms.com https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/ https://maps.google.com https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' blob: data: https://avatars.githubusercontent.com https://raw.githubusercontent.com; media-src 'self' blob:; connect-src 'self' blob: data: https://api.github.com https://www.githubstatus.com https://unpkg.com; frame-src blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon-32.png"
    }
  ]
}
